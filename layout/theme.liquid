<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="{{ settings.theme_mode }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-custom-fonts' %}
    {% render 'css-variables' %}

    {% # Important asset loading %}
    {% render 'theme-mode-head' %}

    {% # load and preload critical fonts %}
    {% if settings.use_brand_typography %}
      <link rel="preload" href="{{ 'Gabarito-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
      <link rel="preload" href="{{ 'NotoSerif-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    {% else %}
      {% unless settings.font_body.system? %}
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
        {{ settings.font_body | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {% endunless %}
    {% endif %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}


    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # Loading Favicon items %}
    {%- comment -%}
      Favicons (Theme settings)
      - favicon_32 (32x32 png)
      - favicon_16 (16x16 png)
      - apple_touch_icon_180 (180x180 png)
      - favicon_ico (optional, may not be supported by image_picker in some themes)
    {%- endcomment -%}
    <link rel="icon" href="{% if settings.favicon_ico != blank %}{{ settings.favicon_ico | file_url }}{% else %}{{ 'favicon.ico' | asset_url }}{% endif %}">

    {% if settings.favicon_32 != blank %}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon_32 | image_url: width: 32, height: 32 }}">
    {% endif %}

    {% if settings.favicon_16 != blank %}
      <link rel="icon" type="image/png" sizes="16x16" href="{{ settings.favicon_16 | image_url: width: 16, height: 16 }}">
    {% endif %}

    {% if settings.apple_touch_icon_180 != blank %}
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.apple_touch_icon_180 | image_url: width: 180, height: 180 }}">
    {% endif %}

    {{ content_for_header }}

    {{ 'tailwind.css' |  asset_url |  stylesheet_tag }}

    <script src="{{ 'iconify-icon.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ui-tag.js' | asset_url }}" defer></script>

    <script src="{{ 'ggms-logo-lockup.js' | asset_url }}" defer></script>
    <script src="{{ 'ggms-header.js' | asset_url }}" defer></script>

    <script src="{{ 'ggms-cart-api.js' | asset_url }}" defer></script>
    <script src="{{ 'ggms-cart-drawer.js' | asset_url }}" defer></script>


  </head>

  <body>
    {% render 'ui-skip-to-content' %}

    {% sections 'announcement-bar' %}
    {% sections 'header-group' %}
    <div id="header-scroll-sentinel" class="absolute top-37.5 h-0 w-0 pointer-events-none" aria-hidden="true"></div>

    <main id="MainContent" role="main">
      {% render 'ui-breadcrumbs', menu_handle: 'collections-menu', all_products_url: '/collections/all', show_schema: true %}
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'ui-icon-sprite' %}
  </body>
</html>