{% comment %}
  Section: Header
{% endcomment %}

<header class="w-full border-b border-border bg-surface" data-site-header>
  <div class="mx-auto flex max-w-page h-full items-center justify-between px-gutter">

    <div class="flex items-center w-37.5 overflow-visible shrink-0">
      {% render 'ui-logo-lockup' %}
    </div>

    <div class="hidden md:block">
      {% render 'primary-nav-links', menu: section.settings.menu %}
    </div>

    <div class="flex items-center gap-2">
      {% render 'primary-mobile-nav-links', menu: section.settings.menu %}
      {% render 'ui-cart-drawer' %}
    </div>

  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}