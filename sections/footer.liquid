{% comment %}
  footer

  Column-based footer section:
  - Every block has a "column" setting (1, 2, or 3)
  - Blocks assigned to the same column stack vertically with dividers
  - Link strip blocks always render full-width below the grid
  - Social icons is its own block type, placeable in any column

  Section settings:
  - show_help_strip / help_heading / help_text
  - primary_cta_mode / primary_cta_label / primary_cta_phone / primary_cta_url
  - secondary_cta_label / secondary_cta_link
  - show_policy_links / copyright_name / show_payment_icons

  Blocks:
  - contact: store info + optional hours
  - menu: link list menu
  - richtext: text block
  - newsletter: email signup
  - social_icons: social media icon row
  - link_strip: full-width horizontal row of links
{% endcomment %}

<footer class="relative border-t-2 bg-surface text-text" style="border-top-color: var(--ggms-brand-blue);" data-site-footer>
  {% render 'ui-back-to-top', position: 'left' %}

  {%- comment -%} ── Help strip ── {%- endcomment -%}
  {%- if section.settings.show_help_strip -%}
    {%- assign _primary_href = '' -%}
    {%- if section.settings.primary_cta_mode == 'phone' -%}
      {%- assign _tel = section.settings.primary_cta_phone | default: '' -%}
      {%- assign _clean_tel = _tel | replace: '(', '' | replace: ')', '' | replace: '-', '' | replace: ' ', '' | replace: '.', '' -%}
      {%- if _clean_tel != blank -%}
        {%- assign _primary_href = 'tel:' | append: _clean_tel -%}
      {%- endif -%}
    {%- else -%}
      {%- if section.settings.primary_cta_url != blank -%}
        {%- assign _primary_href = section.settings.primary_cta_url -%}
      {%- endif -%}
    {%- endif -%}

    <div class="bg-brand-blue text-white">
      <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div class="max-w-none sm:max-w-100 lg:max-w-150">
            {%- if section.settings.help_heading != blank -%}
              <p class="font-heading text-lg font-semibold sm:text-xl text-white">{{ section.settings.help_heading }}</p>
            {%- endif -%}
            {%- if section.settings.help_text != blank -%}
              <p class="mt-1 text-sm text-white/70">{{ section.settings.help_text }}</p>
            {%- endif -%}
          </div>
          <div class="flex flex-col gap-2 xs:flex-row xs:items-center">
            {%- if section.settings.primary_cta_label != blank and _primary_href != blank -%}
              {% render 'ui-button',
                variant: 'secondary-on-blue',
                href: _primary_href,
                label: section.settings.primary_cta_label,
                class: 'shrink-0'
              %}
            {%- endif -%}
            {%- if section.settings.secondary_cta_label != blank and section.settings.secondary_cta_link != blank -%}
              {% render 'ui-button',
                variant: 'cta-basic',
                href: section.settings.secondary_cta_link,
                label: section.settings.secondary_cta_label,
                class: 'shrink-0'
              %}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── Main footer grid (column-based) ── {%- endcomment -%}
  <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid items-stretch gap-6 sm:gap-10 md:grid-cols-12 pb-12">

      {%- for col in (1..3) -%}
        {%- assign col_str = col | append: '' -%}
        {%- assign col_has_blocks = false -%}

        {%- for block in section.blocks -%}
          {%- if block.type != 'link_strip' and block.settings.column == col_str -%}
            {%- assign col_has_blocks = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if col_has_blocks -%}
          {%- assign col_block_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'link_strip' and block.settings.column == col_str -%}
              {%- assign col_block_count = col_block_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          <div class="md:col-span-4 flex flex-col h-full gap-6 justify-center">
            {%- assign col_index = 0 -%}

            {%- for block in section.blocks -%}
              {%- if block.type == 'link_strip' or block.settings.column != col_str -%}
                {%- continue -%}
              {%- endif -%}

              {%- if col_index > 0 -%}
                {%- if col_block_count == 2 -%}
                  <div class="flex-1 flex items-center">
                    <div class="h-px w-full bg-border"></div>
                  </div>
                {%- else -%}
                  <div class="mt-5 pt-5 border-t border-border"></div>
                {%- endif -%}
              {%- endif -%}
              {%- assign col_index = col_index | plus: 1 -%}

              {%- case block.type -%}

                {%- when 'contact' -%}
                  <div {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <p class="font-heading text-base font-semibold tracking-[-0.01em] text-brand-burgundy">{{ block.settings.heading }}</p>
                    {%- endif -%}
                    {%- if block.settings.subheading != blank -%}
                      <p class="mt-0.5 text-sm italic text-link">{{ block.settings.subheading }}</p>
                    {%- endif -%}

                    <div class="mt-1">
                      {% render 'ui-quick-contact',
                        mode: 'footer',
                        show_heading: false,
                        location_url: block.settings.location_url,
                        menu: 'contact-us'
                      %}
                    </div>

                    {%- if block.settings.hours != blank -%}
                      <div class="mt-3">
                        <div class="pt-1 pb-0.5 text-xs font-semibold uppercase tracking-wide text-muted">Hours</div>
                        <div class="text-xs">{{ block.settings.hours }}</div>
                      </div>
                    {%- endif -%}

                    {%- if block.settings.division_line != blank -%}
                      <p class="mt-2 text-xs italic text-muted/60">{{ block.settings.division_line }}</p>
                    {%- endif -%}
                  </div>

                {%- when 'menu' -%}
                  <nav aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <p class="font-heading text-base font-semibold tracking-[-0.01em] text-brand-burgundy">{{ block.settings.heading }}</p>
                    {%- endif -%}
                    {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                      <ul class="mt-4 space-y-2 text-sm">
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            {% render 'ui-link',
                              href: link.url,
                              label: link.title,
                              variant: 'footer',
                              underline: true
                            %}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </nav>

                {%- when 'richtext' -%}
                  <div {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <p class="font-heading text-base font-semibold tracking-[-0.01em] text-brand-burgundy">{{ block.settings.heading }}</p>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="mt-2 text-sm text-muted">{{ block.settings.text }}</div>
                    {%- endif -%}
                    {%- if block.settings.cta_label != blank and block.settings.cta_link != blank -%}
                      <div class="mt-2">
                        {% render 'ui-button',
                          variant: 'secondary',
                          href: block.settings.cta_link,
                          label: block.settings.cta_label
                        %}
                      </div>
                    {%- endif -%}
                  </div>

                {%- when 'newsletter' -%}
                  <div {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <p class="font-heading text-base font-semibold tracking-[-0.01em] text-brand-burgundy">{{ block.settings.heading }}</p>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <p class="mt-4 text-sm text-muted">{{ block.settings.text }}</p>
                    {%- endif -%}

                    <div class="mt-4">
                      {%- form 'customer', id: 'FooterNewsletterForm', class: 'flex flex-col gap-2' -%}
                        <input type="hidden" name="contact[tags]" value="newsletter">

                        {% render 'form-input',
                          name: 'contact[email]',
                          id: 'FooterNewsletterEmail',
                          type: 'email',
                          placeholder: block.settings.placeholder | default: 'Email address',
                          autocomplete: 'email',
                          required: true,
                          no_validate: true,
                          wrapper_class: 'flex-1'
                        %}

                        {% render 'ui-button',
                          variant: 'secondary',
                          type: 'submit',
                          label: block.settings.button_label | default: 'Subscribe'
                        %}
                      {%- endform -%}
                    </div>
                  </div>

                {%- when 'social_icons' -%}
                  <div {{ block.shopify_attributes }} class="pb-6 sm:pb-0">
                    {%- if block.settings.heading != blank -%}
                      <p class="font-heading text-base font-semibold tracking-[-0.01em] text-brand-burgundy">{{ block.settings.heading }}</p>
                    {%- endif -%}
                    <div class="{% if block.settings.heading != blank %}mt-4{% endif %}">
                      {% render 'ui-social-icons' %}
                    </div>
                  </div>

              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    {%- comment -%} ── Link strip blocks (full-width below the grid) ── {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'link_strip' -%}
        <div class="border-t border-border pt-6" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <p class="font-heading text-base font-semibold tracking-[-0.01em] text-brand-burgundy text-center">{{ block.settings.heading }}</p>
          {%- endif -%}
          {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
            <nav class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label="{{ block.settings.heading | default: 'Footer links' | escape }}">
              {%- for link in block.settings.menu.links -%}
                {% render 'ui-link',
                  href: link.url,
                  label: link.title,
                  variant: 'footer',
                  underline: true
                %}
              {%- endfor -%}
            </nav>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} ── Unified bottom bar: copyright + payment ── {%- endcomment -%}
  <div class="border-t border-border bg-brand-blue text-white/70">
    <div class="mx-auto w-full max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
      {%- assign _year = 'now' | date: '%Y' -%}
      <div class="flex flex-col items-center gap-3 text-center text-xs md:flex-row md:justify-between md:text-left">
        <div class="flex flex-col items-center gap-2 md:flex-row md:items-center md:gap-4">
          <a class="text-white/70 hover:text-white no-underline flex items-center gap-1" href="{{ shop.url }}">
            {% render 'ui-icon', name: 'lucide:copyright' %}
            <span class="pt-px">
              {{ _year }} {{ section.settings.copyright_name }}. All rights reserved.
            </span>
          </a>

          {%- if section.settings.show_policy_links -%}
            {%- assign _has_policies = false -%}
            {%- if shop.policies.privacy_policy != blank or shop.policies.terms_of_service != blank or shop.policies.refund_policy != blank or shop.policies.shipping_policy != blank -%}
              {%- assign _has_policies = true -%}
            {%- endif -%}

            {%- if _has_policies -%}
              <span class="hidden md:inline text-white/30">|</span>
              <nav class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1" aria-label="Legal policies">
                {%- if shop.policies.privacy_policy != blank -%}
                  {% render 'ui-link', href: shop.policies.privacy_policy.url, label: shop.policies.privacy_policy.title, variant: 'footer', underline: true %}
                {%- endif -%}
                {%- if shop.policies.terms_of_service != blank -%}
                  {% render 'ui-link', href: shop.policies.terms_of_service.url, label: shop.policies.terms_of_service.title, variant: 'footer', underline: true %}
                {%- endif -%}
                {%- if shop.policies.refund_policy != blank -%}
                  {% render 'ui-link', href: shop.policies.refund_policy.url, label: shop.policies.refund_policy.title, variant: 'footer', underline: true %}
                {%- endif -%}
                {%- if shop.policies.shipping_policy != blank -%}
                  {% render 'ui-link', href: shop.policies.shipping_policy.url, label: shop.policies.shipping_policy.title, variant: 'footer', underline: true %}
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if section.settings.show_payment_icons -%}
          <div class="flex items-center">
            {% render 'ui-payment-icons', tight: true %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "GGMS Footer",
  "tag": "footer",
  "class": "section-ggms-footer",
  "settings": [
    {
      "type": "header",
      "content": "Help strip"
    },
    { "type": "checkbox", "id": "show_help_strip", "label": "Show help strip", "default": true },
    { "type": "text", "id": "help_heading", "label": "Help heading", "default": "Need help choosing the right equipment?" },
    { "type": "text", "id": "help_text", "label": "Help text", "default": "Call us and we'll help you figure out what you need and what coverage may apply." },
    {
      "type": "select",
      "id": "primary_cta_mode",
      "label": "Primary CTA mode",
      "default": "phone",
      "options": [
        { "value": "phone", "label": "Phone (tel:)" },
        { "value": "url", "label": "URL" }
      ]
    },
    { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label", "default": "Call (719) 569-7361" },
    { "type": "text", "id": "primary_cta_phone", "label": "Primary CTA phone (used when mode=Phone)", "default": "(719) 569-7361" },
    { "type": "url", "id": "primary_cta_url", "label": "Primary CTA URL (used when mode=URL)" },
    { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label", "default": "Contact Us" },
    { "type": "url", "id": "secondary_cta_link", "label": "Secondary CTA link" },

    {
      "type": "header",
      "content": "Bottom bar"
    },
    { "type": "checkbox", "id": "show_policy_links", "label": "Show Shopify policy links in bottom bar", "default": true },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "Golden Gate Medical Supply" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons in bottom bar", "default": true }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "default": "1",
          "options": [
            { "value": "1", "label": "Column 1 (left)" },
            { "value": "2", "label": "Column 2 (center)" },
            { "value": "3", "label": "Column 3 (right)" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Golden Gate Medical Supply" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Your Gateway to Better Health" },
        { "type": "url", "id": "location_url", "label": "Location page URL" },
        { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Contact Us" },
        { "type": "url", "id": "contact_link", "label": "Contact button link" },
        { "type": "richtext", "id": "hours", "label": "Hours (optional)", "default": "<p>Mon-Fri: 8am-4pm</p>" },
        { "type": "text", "id": "division_line", "label": "Division line (optional)", "default": "A Division of Golden Gate Manor Inc." }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "default": "2",
          "options": [
            { "value": "1", "label": "Column 1 (left)" },
            { "value": "2", "label": "Column 2 (center)" },
            { "value": "3", "label": "Column 3 (right)" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quick Links" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "richtext",
      "name": "Rich text",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "default": "3",
          "options": [
            { "value": "1", "label": "Column 1 (left)" },
            { "value": "2", "label": "Column 2 (center)" },
            { "value": "3", "label": "Column 3 (right)" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Insurance & Billing" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We can help you understand coverage basics and next steps. We focus on clear guidance—no pressure.</p>" },
        { "type": "text", "id": "cta_label", "label": "CTA label" },
        { "type": "url", "id": "cta_link", "label": "CTA link" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "default": "3",
          "options": [
            { "value": "1", "label": "Column 1 (left)" },
            { "value": "2", "label": "Column 2 (center)" },
            { "value": "3", "label": "Column 3 (right)" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Updates & Education" },
        { "type": "text", "id": "text", "label": "Text", "default": "Get practical tips, product education, and store updates." },
        { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Email address" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
      ]
    },
    {
      "type": "social_icons",
      "name": "Social icons",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "default": "2",
          "options": [
            { "value": "1", "label": "Column 1 (left)" },
            { "value": "2", "label": "Column 2 (center)" },
            { "value": "3", "label": "Column 3 (right)" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading (optional)", "default": "Follow Us" }
      ]
    },
    {
      "type": "link_strip",
      "name": "Link strip",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading (optional)", "default": "Policies & Conditions" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Create a menu in Navigation with the links you want displayed horizontally." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "GGMS Footer",
      "blocks": [
        { "type": "contact" },
        { "type": "menu" },
        { "type": "social_icons" },
        { "type": "richtext" },
        { "type": "newsletter" },
        { "type": "link_strip" }
      ]
    }
  ]
}
{% endschema %}