{% comment %}
  ggms-home-preview

  Purpose:
  - Actual homepage preview section
  - Hero with full clickable featured collection card
  - Category cards driven by collection picker blocks
  - Built for direct use on templates/index.json or templates/index.liquid

  Notes:
  - Select the featured collection in the theme editor
  - Add category card blocks and assign collections there
  - Uses collection.image, collection.title, collection.url, collection.products_count
{% endcomment %}

{% assign featured_collection = section.settings.featured_collection %}
{% assign hero_carousel_id = 'hero-card-carousel-' | append: section.id %}

<section class="bg-page text-text">
  <div class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-linear-to-br from-brand-blue/5 via-transparent to-brand-burgundy/5">
      <img src="https://firebasestorage.googleapis.com/v0/b/goldengatemanorinc.firebasestorage.app/o/marketing-edits%2Fhex-top-left.png?alt=media&token=49ae70f0-de1b-43c2-bfc3-528c91919680" alt="Hex comb top left" class="absolute top-0 left-0 w-1/3 max-w-sm opacity-50">
      <img src="https://firebasestorage.googleapis.com/v0/b/goldengatemanorinc.firebasestorage.app/o/marketing-edits%2Fhex-bottom-left.png?alt=media&token=b2e69bae-7b18-4715-b501-011d68216d96" alt="Hex comb bottom left" class="absolute bottom-0 left-0 w-1/2 max-w-md opacity-50">
      <img src="https://firebasestorage.googleapis.com/v0/b/goldengatemanorinc.firebasestorage.app/o/marketing-edits%2Fhex-top-right.png?alt=media&token=f364a6d7-f32b-47b6-8ec5-bb23075eae97" alt="Hex comb top right" class="absolute top-0 right-0 w-1/2 max-w-md opacity-50">
      <img src="https://firebasestorage.googleapis.com/v0/b/goldengatemanorinc.firebasestorage.app/o/marketing-edits%2Fhex-bottom-right.png?alt=media&token=00122410-a811-4c98-b907-3dd1f26a7841" alt="Hex comb bottom right" class="absolute bottom-0 right-0 w-1/3 max-w-sm opacity-50">

    </div>

    <div class="mx-auto max-w-7xl px-gutter py-12 sm:py-14 lg:py-16">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-12">
        <div class="space-y-8">
          {% if section.settings.eyebrow != blank %}
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-blue">{{ section.settings.eyebrow }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight text-text sm:text-5xl lg:text-6xl">{{ section.settings.heading }}</h1>
          {% endif %}

          {% if section.settings.body != blank %}
            <div class="max-w-2xl text-lg leading-relaxed text-muted rte">{{ section.settings.body }}</div>
          {% endif %}

          <div class="flex flex-wrap items-center gap-4">
            {% if section.settings.primary_cta_label != blank and section.settings.primary_cta_link != blank %}
              {% render 'ui-button', variant: 'cta', cta_size: 'sm', content: section.settings.primary_cta_label, href: section.settings.primary_cta_link %}
            {% endif %}

            {% if section.settings.secondary_cta_label != blank and section.settings.secondary_cta_link != blank %}
              {% render 'ui-button', variant: 'ghost', content: section.settings.secondary_cta_label, href: section.settings.secondary_cta_link %}
            {% endif %}
          </div>

          {% if section.settings.note_label != blank or section.settings.note_text != blank %}
            {% render 'ui-note-inline', label: section.settings.note_label, content: section.settings.note_text %}
          {% endif %}
        </div>

        <div class="relative flex w-full justify-center overflow-visible lg:justify-end lg:pl-8">
          {% render 'ui-card-carousel', blocks: section.blocks, block_type: 'hero_card', carousel_id: hero_carousel_id, empty_text: 'Select collections to populate this carousel.' %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-surface">
  <div class="mx-auto max-w-7xl px-gutter py-6">
    {% if section.settings.trust_title != blank or section.settings.trust_message != blank %}
      {% render 'ui-alert', variant: 'cart', mode: 'inline', title: section.settings.trust_title, message: section.settings.trust_message, action_label: section.settings.trust_action_label, action_url: section.settings.trust_action_url, compact: true %}
    {% endif %}
  </div>
</section>

<section class="bg-page">
  <div class="mx-auto max-w-7xl px-gutter py-16 space-y-10">
    <div class="space-y-3 text-center">
      {% if section.settings.categories_heading != blank %}
        <h2 class="text-3xl font-extrabold tracking-tight text-text">{{ section.settings.categories_heading }}</h2>
      {% endif %}

      {% if section.settings.categories_body != blank %}
        <p class="mx-auto max-w-2xl text-muted">{{ section.settings.categories_body }}</p>
      {% endif %}
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {% for block in section.blocks %}
        {% if block.type == 'category_card' %}
          {% assign card_collection = block.settings.collection %}

          {% if card_collection != blank %}
            <a href="{{ card_collection.url }}" class="group block overflow-hidden rounded-[2rem] border border-[#eceef3] bg-white p-5 shadow-[0_10px_24px_rgba(15,23,42,0.08)] transition duration-200 hover:-translate-y-1 hover:shadow-[0_16px_34px_rgba(15,23,42,0.12)]" {{ block.shopify_attributes }}>
              <div class="space-y-4">
                <div class="space-y-2">
                  <h3 class="font-heading text-2xl leading-tight text-brand-burgundy">
                    {% if block.settings.custom_title != blank %}
                      {{ block.settings.custom_title }}
                    {% else %}
                      {{ card_collection.title }}
                    {% endif %}
                  </h3>

                  <div class="flex items-center gap-2 text-base font-bold text-brand-blue">
                    <span>{{ block.settings.link_label | default: 'Explore products' }}</span>
                    <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                  </div>
                </div>

                <div class="overflow-hidden rounded-[1.5rem] border border-[#eef1f6] bg-white shadow-[inset_0_1px_0_rgba(255,255,255,0.9),inset_0_0_0_1px_rgba(15,23,42,0.02),inset_0_-16px_32px_rgba(37,99,235,0.025)]">
                  {% if card_collection.image %}
                    <div class="aspect-square overflow-hidden rounded-[1.125rem] bg-white">
                      {{ card_collection.image | image_url: width: 900 | image_tag: class: 'h-full w-full scale-[1.05] object-cover object-center transition duration-300 group-hover:scale-[1.08]', loading: 'lazy', alt: card_collection.title }}
                    </div>
                  {% else %}
                    <div class="aspect-square rounded-[1.125rem] bg-white"></div>
                  {% endif %}
                </div>

                <div class="flex items-center justify-between text-sm text-muted">
                  <span>{{ card_collection.products_count }} products</span>
                  <span class="font-semibold text-brand-blue">View collection</span>
                </div>

                <div class="h-[3px] w-full overflow-hidden rounded-full bg-[#e7ebf3]">
                  <div class="flex h-full w-full">
                    <div class="h-full w-1/2 bg-brand-burgundy"></div>
                    <div class="h-full w-1/2 bg-brand-blue"></div>
                  </div>
                </div>
              </div>
            </a>
          {% else %}
            <div class="overflow-hidden rounded-[2rem] border border-[#eceef3] bg-white p-5 shadow-[0_10px_24px_rgba(15,23,42,0.08)]" {{ block.shopify_attributes }}>
              <p class="text-sm text-muted">Select a collection for this card.</p>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

