[
  {
    "name": "theme_info",
    "theme_name": "GGMS Theme",
    "theme_version": "2.0.0",
    "theme_author": "Zachary Thallas",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "Favicon Settings",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon_32",
        "label": "Favicon 32x32"
      },
      {
        "type": "image_picker",
        "id": "favicon_16",
        "label": "Favicon 16x16"
      },
      {
        "type": "image_picker",
        "id": "apple_touch_icon_180",
        "label": "Apple touch icon 180x180"
      },
      {
        "type": "image_picker",
        "id": "favicon_ico",
        "label": "Favicon .ico (optional)"
      }
    ]
  },
  {
    "name": "Company settings",
    "settings": [
      { "type": "header", "content": "Company identity" },
      {
        "type": "text",
        "id": "company_name",
        "label": "Company name",
        "default": "Golden Gate Medical Supply"
      },
      {
        "type": "text",
        "id": "company_legal_name",
        "label": "Legal name (optional)",
        "default": "Golden Gate Manor Inc"
      },

      { "type": "header", "content": "Contact" },
      {
        "type": "text",
        "id": "company_phone_display",
        "label": "Primary phone (display)",
        "default": "(719) 569-7361"
      },
      {
        "type": "text",
        "id": "company_phone_tel",
        "label": "Primary phone (tel link)",
        "info": "Example: +18445551234",
        "default": "+17195697361"
      },
      {
        "type": "text",
        "id": "company_phone2_display",
        "label": "Secondary phone (display) (optional)"
      },
      {
        "type": "text",
        "id": "company_phone2_tel",
        "label": "Secondary phone (tel link) (optional)",
        "info": "Example: +18445551234"
      },
      {
        "type": "text",
        "id": "company_fax_display",
        "label": "Fax number (display)",
        "default": "(719) 696-8548"
      },
      {
        "type": "text",
        "id": "company_fax_tel",
        "label": "Fax number (tel link) (optional)",
        "info": "Example: +17195551234",
        "default": "+17196968548"
      },
      {
        "type": "text",
        "id": "company_support_email",
        "label": "Customer support email",
        "default": "support@goldengatemedicalsupply.com"
      },

      { "type": "header", "content": "Primary location" },
      {
        "type": "text",
        "id": "company_address_line1",
        "label": "Address line 1",
        "default": "612 S. Union Ave."
      },
      {
        "type": "text",
        "id": "company_address_line2",
        "label": "Address line 2 (optional)"
      },
      {
        "type": "text",
        "id": "company_city",
        "label": "City",
        "default": "Pueblo"
      },
      {
        "type": "text",
        "id": "company_state",
        "label": "State",
        "default": "Colorado"
      },
      {
        "type": "text",
        "id": "company_postal_code",
        "label": "ZIP / Postal code",
        "default": "81004"
      },
      {
        "type": "text",
        "id": "company_country",
        "label": "Country",
        "default": "US"
      },

      { "type": "header", "content": "Secondary location (optional)" },
      {
        "type": "checkbox",
        "id": "company_has_location2",
        "label": "Enable secondary location",
        "default": false
      },
      {
        "type": "text",
        "id": "company2_address_line1",
        "label": "Address line 1"
      },
      {
        "type": "text",
        "id": "company2_address_line2",
        "label": "Address line 2 (optional)"
      },
      {
        "type": "text",
        "id": "company2_city",
        "label": "City"
      },
      {
        "type": "text",
        "id": "company2_state",
        "label": "State"
      },
      {
        "type": "text",
        "id": "company2_postal_code",
        "label": "ZIP / Postal code"
      },
      {
        "type": "text",
        "id": "company2_country",
        "label": "Country",
        "default": "US"
      },

      { "type": "header", "content": "Business details (optional)" },
      {
        "type": "text",
        "id": "company_hours_short",
        "label": "Hours (short display)",
        "info": "Example: Mon-Fri 9-5",
        "default": "M-F (8AM-4PM)"
      },
      {
        "type": "textarea",
        "id": "company_hours_full",
        "label": "Hours (full text)",
        "info": "Example: Mon-Fri: 9am-5pm\nSat: 10am-2pm\nSun: Closed",
        "default": "Mon-Fri: 8:00AM-4:00PM"
      },
      {
        "type": "url",
        "id": "company_google_maps_url",
        "label": "Google Maps URL (optional)"
      },
      {
        "type": "text",
        "id": "company_tax_id",
        "label": "Tax ID / EIN (optional)",
        "default": "27-1074324"
      }
    ]
  },
  {
    "name": "Company logos",
    "settings": [
      { "type": "header", "content": "Logos" },

      {
        "type": "image_picker",
        "id": "company_logo_primary",
        "label": "Primary logo (large)"
      },
      {
        "type": "image_picker",
        "id": "company_logo_secondary",
        "label": "Secondary logo (small / text)"
      },

      { "type": "header", "content": "Logo display (optional)" },

      {
        "type": "range",
        "id": "company_logo_primary_max_width",
        "label": "Primary logo max width",
        "min": 80,
        "max": 420,
        "step": 10,
        "unit": "px",
        "default": 220
      },
      {
        "type": "range",
        "id": "company_logo_secondary_max_width",
        "label": "Secondary logo max width",
        "min": 80,
        "max": 420,
        "step": 10,
        "unit": "px",
        "default": 180
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Brand foundation",
    "settings": [
      { "type": "header", "content": "Typography" },
      {
        "type": "checkbox",
        "id": "use_brand_typography",
        "default": true,
        "label": "Use brand typography (Gabarito + Noto Serif)"
      },
      {
        "type": "paragraph",
        "content": "When enabled, the Body font and Heading font selectors below are ignored."
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "default": "work_sans_n4",
        "label": "Body font"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "default": "work_sans_n4",
        "label": "Heading font"
      },

      { "type": "header", "content": "Colors" },

      {
        "type": "color",
        "id": "color_page_bg",
        "default": "#e8e8e8",
        "label": "Page background"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "#fdfbf6",
        "label": "Surface / cards / header"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "#e1e1e1",
        "label": "Border"
      },

      {
        "type": "color",
        "id": "color_text",
        "default": "#1e1e1e",
        "label": "Primary text"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "default": "#646464",
        "label": "Muted text"
      },

      {
        "type": "color",
        "id": "color_brand_primary",
        "default": "#121B75",
        "label": "Brand primary (blue)"
      },
      {
        "type": "color",
        "id": "color_brand_accent",
        "default": "#A3150D",
        "label": "Brand accent (burgundy)"
      },

      { "type": "header", "content": "Radii" },

      {
        "type": "range",
        "id": "radius_input",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "Input radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Theme mode",
    "settings": [
      {
        "type": "select",
        "id": "theme_mode",
        "label": "Color mode",
        "default": "system",
        "options": [
          { "value": "light", "label": "Light" },
          { "value": "dark", "label": "Dark" },
          { "value": "system", "label": "System" }
        ]
      },
      {
        "type": "checkbox",
        "id": "theme_mode_allow_override",
        "label": "Allow customer override (saved in browser)",
        "default": true
      },

      { "type": "header", "content": "Dark theme colors" },

      {
        "type": "color",
        "id": "color_page_bg_dark",
        "default": "#212121",
        "label": "Dark page background"
      },
      {
        "type": "color",
        "id": "color_surface_dark",
        "default": "#2b2b2b",
        "label": "Dark surface"
      },
      {
        "type": "color",
        "id": "color_border_dark",
        "default": "#3a3a3a",
        "label": "Dark border"
      },
      {
        "type": "color",
        "id": "color_text_dark",
        "default": "#f1f1f1",
        "label": "Dark primary text"
      },
      {
        "type": "color",
        "id": "color_text_muted_dark",
        "default": "#b6b6b6",
        "label": "Dark muted text"
      },
      {
        "type": "color",
        "id": "color_base_icon",
        "default": "#FFFFFF",
        "label": "Base icon color"
      },
      {
        "type": "color",
        "id": "color_button_hover",
        "default": "#DCDCDC",
        "label": "Button hover color"
      },

      { "type": "header", "content": "Dark theme brand tuning (optional)" },

      {
        "type": "color",
        "id": "color_brand_primary_dark",
        "default": "#2e3a95",
        "label": "Brand blue (lighter)"
      },
      {
        "type": "color",
        "id": "color_brand_accent_dark",
        "default": "#b63a2a",
        "label": "Brand burgundy (lighter)"
      },
      {
        "type": "color",
        "id": "color_link_dark",
        "default": "#5A6BFF",
        "label": "Dark link color"
      },
      {
        "type": "color",
        "id": "color_link_hover_dark",
        "default": "#cb5648",
        "label": "Dark link hover color"
      },
      {
        "type": "color",
        "id": "color_button_hover_dark",
        "default": "#3D3D3D",
        "label": "Dark button hover color"
      },
      {
        "type": "color",
        "id": "color_base_icon_dark",
        "default": "#000000",
        "label": "Dark base icon color"
      }
    ]
  }
]
