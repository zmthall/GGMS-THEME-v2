{% comment %}
  ui-social-icons

  Renders a row of social-media SVG icon links.
  Reads from global theme settings (Settings > Social handles).
  Falls back to hardcoded defaults if settings are empty.

  Usage:
    {% render 'ui-social-icons' %}
{% endcomment %}

{%- liquid
  assign _facebook = settings.social_facebook_url | default: 'https://www.facebook.com/GoldenGateMedicalSupply'
  assign _instagram = settings.social_instagram_url | default: 'https://www.instagram.com/goldengatemedicalsupplies/'
  assign _youtube = settings.social_youtube_url | default: 'https://www.youtube.com/@GoldenGateManorInc'
  assign _google = settings.social_google_url | default: 'https://share.google/dzPuEdtPHInq1JWlF'
  assign _pinterest = settings.social_pinterest_url | default: 'https://www.pinterest.com/GoldenGateMedicalSupply/'
  assign _x = settings.social_x_url | default: 'https://x.com/GoldenGateManor'
  assign _linkedin = settings.social_linkedin_url | default: ''
  assign _tiktok = settings.social_tiktok_url | default: ''
-%}

<div class="ggms-social flex items-center flex-wrap gap-3">

  {%- if _facebook != blank -%}
    <a href="{{ _facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"
       class="flex items-center justify-center w-8 h-8 rounded-full border border-border text-muted hover:bg-brand-burgundy hover:border-brand-burgundy hover:text-white transition-colors duration-fast ease-standard">
      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
    </a>
  {%- endif -%}

  {%- if _instagram != blank -%}
    <a href="{{ _instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"
       class="flex items-center justify-center w-8 h-8 rounded-full border border-border text-muted hover:bg-brand-burgundy hover:border-brand-burgundy hover:text-white transition-colors duration-fast ease-standard">
      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.17.054 1.97.24 2.43.403a4.088 4.088 0 011.47.957c.453.453.764.897.957 1.47.163.46.35 1.26.404 2.43.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.054 1.17-.24 1.97-.404 2.43a4.088 4.088 0 01-.957 1.47 4.088 4.088 0 01-1.47.957c-.46.163-1.26.35-2.43.404-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.17-.054-1.97-.24-2.43-.404a4.088 4.088 0 01-1.47-.957 4.088 4.088 0 01-.957-1.47c-.163-.46-.35-1.26-.404-2.43C2.175 15.584 2.163 15.204 2.163 12s.012-3.584.07-4.85c.054-1.17.24-1.97.404-2.43a4.088 4.088 0 01.957-1.47A4.088 4.088 0 015.064 2.293c.46-.163 1.26-.35 2.43-.404C8.76 1.831 9.14 1.82 12 1.82V2.163zM12 0C8.741 0 8.333.014 7.053.072c-1.277.058-2.15.261-2.913.558a5.882 5.882 0 00-2.126 1.384A5.882 5.882 0 00.63 4.14C.333 4.903.13 5.776.072 7.053.014 8.333 0 8.741 0 12s.014 3.667.072 4.947c.058 1.277.261 2.15.558 2.913a5.882 5.882 0 001.384 2.126 5.882 5.882 0 002.126 1.384c.763.297 1.636.5 2.913.558C8.333 23.986 8.741 24 12 24s3.667-.014 4.947-.072c1.277-.058 2.15-.261 2.913-.558a5.882 5.882 0 002.126-1.384 5.882 5.882 0 001.384-2.126c.297-.763.5-1.636.558-2.913.058-1.28.072-1.688.072-4.947s-.014-3.667-.072-4.947c-.058-1.277-.261-2.15-.558-2.913a5.882 5.882 0 00-1.384-2.126A5.882 5.882 0 0019.86.63C19.097.333 18.224.13 16.947.072 15.667.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 110 2.881 1.44 1.44 0 010-2.881z"/></svg>
