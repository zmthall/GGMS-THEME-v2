{%- comment -%}
  ui-button

  Args:
    - content: HTML string (preferred "slot") OR label fallback
    - variant: primary | secondary | secondary-on-blue | cta | cta-basic | ghost | danger | link | icon-only (default: primary)
    - type: button | submit | reset (default: button; only if no href)
    - href: string (optional; renders <a>)
    - class: optional
    - attrs: optional raw attrs (data-*, aria-*)
    - disabled: boolean (default false)
    - loading: boolean (default false)
    - aria_label: required if icon-only or no visible text
    - cta_size: (sm | md | lg) optional used to change the sizing of a cta button
    - flex_position: start | end (default: start)

    Icon-only:
    - button_icon: icon name for icon-only (local OR iconify "mdi:home")
    - icon_name: optional explicit icon name for icon-only (local OR iconify). Overrides button_icon if present.
    - button_icon_size: any size string (rem/px/%) (default: 2rem)
    - button_icon_color: tailwind color classes (default: text-base-icon)
    - button_icon_hover_color: tailwind hover classes (default set if blank)
    - button_icon_wrap_class: extra classes for the icon wrapper span (optional)
    - button_icon_class: extra classes applied to the icon itself (optional)

    Icon-only background layer (NEW):
    - icon_bg: boolean (default: true) -> renders an independent background circle behind the icon
    - icon_bg_size_class: tailwind size classes for bg circle (default: 'h-10 w-10')
    - icon_bg_class: classes for bg circle (default: 'bg-brand-blue')
    - icon_bg_hover_class: classes for bg circle hover via group (default: '')
{%- endcomment -%}

{%- liquid
  assign _content = content | default: ''
  assign _label = label | default: ''
  assign _variant = variant | default: 'primary'
  assign _type = type | default: 'button'
  assign _href = href | default: ''
  assign _class = class | default: ''
  assign _attrs = attrs | default: ''
  assign _flex_position = flex_position | default: 'start'
  assign _disabled = disabled | default: false
  assign _loading = loading | default: false
  assign _aria_label = aria_label | default: ''

  assign _cta_icon = cta_icon | default: 'cart'
  assign _cta_size = cta_size | default: 'md'

  assign _button_icon_wrap_class = button_icon_wrap_class | default: ''
  assign _button_icon_class = button_icon_class | default: ''

  assign _button_icon = button_icon | default: ''
  assign _icon_name = icon_name | default: ''
  if _icon_name != blank
    assign _button_icon = _icon_name
  endif

  assign _button_icon_size = button_icon_size | default: '2rem'
  assign _button_icon_color = button_icon_color | default: 'text-base-icon'
  assign _button_icon_hover_color = button_icon_hover_color | default: ''

  if _button_icon_hover_color == blank
    assign _button_icon_hover_color = 'group-hover/button:text-zinc-500'
  endif

  assign _icon_bg = icon_bg
  if _icon_bg == blank
    assign _icon_bg = true
  endif
  assign _icon_bg_size_class = icon_bg_size_class | default: 'h-10 w-10'
  assign _icon_bg_class = icon_bg_class | default: 'bg-brand-blue'
  assign _icon_bg_hover_class = icon_bg_hover_class | default: ''

  if _loading
    assign _disabled = true
  endif

  if _content == blank
    if _label != blank
      assign _content = _label
    endif
  endif

  assign base = 'inline-flex w-fit items-center justify-center gap-2 font-medium select-none cursor-pointer group/button transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none '
  if _flex_position == 'start'
    assign base = base | append: 'self-start '
  elsif _flex_position == 'end'
    assign base = base | append: 'self-end '
  endif

  assign sizing = 'h-control px-4 py-2 text-md '
  assign rounded = 'rounded-md '

  assign variant_classes = ''
  assign cta_icon_sizing = ''
  assign cta_icon_class = ''
  assign cta_button_class = ''

  case _variant
    when 'secondary'
      assign variant_classes = 'bg-surface text-text border border-border hover:bg-brand-blue hover:text-white '
    when 'secondary-on-blue'
      assign variant_classes = 'bg-white text-brand-blue border border-white hover:bg-transparent hover:text-white hover:border-white '
    when 'ghost'
      assign variant_classes = 'bg-transparent text-text hover:bg-button-hover '
    when 'danger'
      assign variant_classes = 'bg-danger text-white hover:bg-danger/90 '
    when 'link'
      assign variant_classes = 'bg-transparent text-link hover:text-link-hover '
      assign sizing = 'p-0 h-auto '
    when 'cta'
      assign rounded = 'rounded-tr-xl '
      case _cta_size
        when 'sm'
          assign sizing = 'py-2 '
          assign cta_icon_sizing = '2rem '
          assign cta_icon_class = '-left-6 '
          assign cta_button_class = 'pl-10 pr-2 ml-6 '
        when 'md'
          assign sizing = 'py-3 '
          assign cta_icon_sizing = '3rem '
          assign cta_icon_class = '-left-10 '
          assign cta_button_class = 'pl-10 pr-3 ml-10 '
        when 'lg'
          assign sizing = 'py-5 '
          assign cta_icon_sizing = '4rem '
          assign cta_icon_class = '-left-16 '
          assign cta_button_class = 'pl-10 pr-5 ml-16 text-xl font-extrabold '
      endcase
      assign variant_classes = 'bg-brand-blue text-white hover:bg-brand-burgundy shadow-primary '
    when 'cta-basic'
      assign variant_classes = 'bg-transparent text-white border border-white/60 hover:bg-brand-burgundy hover:border-brand-burgundy hover:text-white '
    when 'icon-only'
      assign variant_classes = 'text-text '
      assign sizing = 'h-control w-control p-0 '
      assign rounded = 'rounded-full '
    else
      assign variant_classes = 'bg-brand-burgundy text-white hover:bg-brand-blue '
  endcase

  assign base = base | append: rounded

  assign link_disabled = ''
  if _href != blank and _disabled
    assign link_disabled = 'pointer-events-none opacity-50 '
  endif

  assign is_link_missing_href = false
  if _variant == 'link' and _href == blank
    assign is_link_missing_href = true
  endif

  assign needs_aria = false
  if _variant == 'icon-only'
    assign needs_aria = true
  endif

  assign classes = base | append: sizing | append: variant_classes | append: link_disabled | append: ' ' | append: _class
-%}

{%- capture spinner -%}
  <svg class="animate-spin h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
    <circle class="opacity-25" cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="4"></circle>
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v3.5A4.5 4.5 0 0 0 7.5 12H4z"></path>
  </svg>
{%- endcapture -%}

{%- if _href != blank -%}
  <a
    href="{{ _href }}"
    class="{{ classes | strip }} no-underline"
    {%- if needs_aria and _aria_label != blank -%} aria-label="{{ _aria_label | escape }}"{%- endif -%}
    {%- if _disabled -%} aria-disabled="true" tabindex="-1"{%- endif -%}
    {%- if _loading -%} aria-busy="true"{%- endif -%}
    {{ _attrs }}
  >
    <span class="inline-flex items-center gap-2">
      {%- if _loading -%}
        {{ spinner }}
        <span class="sr-only">Loading</span>
      {%- endif -%}
      <span class="{% if _loading %}opacity-70{% endif %}">{{ _content }}</span>
    </span>
  </a>

{%- elsif is_link_missing_href -%}
  <span after="Missing HREF" class="{{ classes | strip }} pointer-events-none opacity-60" aria-disabled="true" {{ _attrs }}>
    <span class="underline underline-offset-4">{{ _content }}</span>
    <span class="ml-2 text-muted no-underline">(Missing HREF)</span>
  </span>

{%- else -%}
  <button
    type="{{ _type }}"
    class="{{ classes | strip }} relative{% if _variant == 'cta' %} shadow-sm {{ cta_button_class }}{% endif %}"
    {%- if needs_aria and _aria_label != blank -%} aria-label="{{ _aria_label | escape }}"{%- endif -%}
    {%- if _disabled -%} disabled{%- endif -%}
    {%- if _loading -%} aria-busy="true"{%- endif -%}
    {{ _attrs }}
  >
    {%- if _variant == 'cta' -%}
      <div class="absolute bg-white top-1/2 rounded-full border border-black -translate-y-1/2 flex items-center justify-center group-hover/button:bg-zinc-100 p-3 {{ cta_icon_class }}">
        {% render 'ui-icon', name: _cta_icon, size: cta_icon_sizing, class: 'text-black' %}
      </div>
    {%- endif -%}

    <span class="inline-flex items-center gap-2">
      {%- if _loading and _variant != 'icon-only' -%}
        {{ spinner }}
        <span class="sr-only">Loading</span>
      {%- endif -%}

      {%- if _variant != 'icon-only' -%}
        <span class="{% if _loading %}opacity-70{% endif %}">{{ _content }}</span>
      {%- else -%}
        {%- assign icon_name_final = _button_icon | default: '' -%}
        {%- assign icon_classes = _button_icon_color | default: '' -%}
        {%- if _button_icon_hover_color != blank -%}
          {%- assign icon_classes = icon_classes | append: ' ' | append: _button_icon_hover_color -%}
        {%- endif -%}
        {%- if _button_icon_class != blank -%}
          {%- assign icon_classes = icon_classes | append: ' ' | append: _button_icon_class -%}
        {%- endif -%}

        {%- assign icon_wrap_classes = 'relative inline-flex items-center justify-center leading-none ' -%}
        {%- if _button_icon_wrap_class != blank -%}
          {%- assign icon_wrap_classes = icon_wrap_classes | append: _button_icon_wrap_class | append: ' ' -%}
        {%- endif -%}
        {%- if _loading -%}
          {%- assign icon_wrap_classes = icon_wrap_classes | append: 'opacity-70 ' -%}
        {%- endif -%}

        <span class="{{ icon_wrap_classes | strip }}">
          {%- if _icon_bg -%}
            {%- assign bg_classes = 'absolute inset-0 rounded-full ' | append: _icon_bg_size_class | append: ' ' | append: _icon_bg_class | append: ' ' -%}
            {%- if _icon_bg_hover_class != blank -%}
              {%- assign bg_classes = bg_classes | append: _icon_bg_hover_class | append: ' ' -%}
            {%- endif -%}
            <span class="{{ bg_classes | strip }}" aria-hidden="true"></span>
          {%- endif -%}

          <span class="relative inline-flex items-center justify-center">
            {%- if icon_name_final != blank -%}
              {% render 'ui-icon', name: icon_name_final, size: _button_icon_size, class: icon_classes %}
            {%- else -%}
              {% render 'ui-icon', name: 'material-symbols:expand-circle-up', size: _button_icon_size, class: icon_classes %}
            {%- endif -%}
          </span>
        </span>
      {%- endif -%}
    </span>
  </button>
{%- endif -%}