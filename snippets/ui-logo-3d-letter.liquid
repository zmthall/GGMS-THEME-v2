{% comment %}
  UI: Logo 3D Letter

  Purpose:
  - Renders a single letter with 3D depth via two stacked spans (depth + face)

  Args:
  - letter: string (required) e.g. "G"
  - class: string (optional) added to wrapper span
  - size: number (optional) font-size in px
  - weight: number (optional) 400..900
  - face: color string (optional) default currentColor
  - depth: color string (optional) default rgba(0,0,0,0.65)
  - edge: color string (optional) used for -webkit-text-stroke
  - stroke: number px (optional) default 0
  - dx: number px (optional) default 2
  - dy: number px (optional) default 3
  - aria_hidden: boolean (optional) default true
{% endcomment %}

{% assign _letter = letter | default: '' %}
{% assign _class = class | default: '' %}
{% assign _size = size | default: 22 %}
{% assign _weight = weight | default: 900 %}
{% assign _face = face | default: 'rgb(var(--ggms-brand-blue-rgb) / 1)' %}
{% assign _depth = depth | default: 'rgba(101,105,63,0.95)' %}
{% assign _edge = edge | default: 'transparent' %}
{% assign _stroke = stroke | default: 0 %}
{% assign _dx = dx | default: 1 %}
{% assign _dy = dy | default: 1 %}

{% assign _aria_hidden = aria_hidden %}
{% if _aria_hidden == blank %}{% assign _aria_hidden = true %}{% endif %}

{% if _letter != '' %}
  <span class="gg-letter-3d {{ _class }}" style="--ggl-face: {{ _face }}; --ggl-depth: {{ _depth }}; --ggl-edge: {{ _edge }}; --ggl-stroke: {{ _stroke }}px; --ggl-dx: {{ _dx }}px; --ggl-dy: {{ _dy }}px;{% if _size != '' %} font-size: {{ _size }}px;{% endif %} font-weight: {{ _weight }};"{% if _aria_hidden %} aria-hidden="true"{% endif %}>
    <span class="gg-letter-3d__depth">{{ _letter }}</span>
    <span class="gg-letter-3d__face">{{ _letter }}</span>
  </span>
{% endif %}
