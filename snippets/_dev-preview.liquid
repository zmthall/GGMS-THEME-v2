<div>
    {% capture body %}
        <div>
            <h1>Global UI</h1>
            <hr class="mb-4">
        </div>
        <div class="space-y-6">
            <h2>UI Primatives</h2>
            <div class="space-y-4">
                <h3>Buttons</h3>
                <div class="flex flex-col items-start gap-6">
                    {% render 'ui-button', variant: 'primary', content: 'Primary Button' %}
                    {% render 'ui-button', variant: 'secondary', content: 'Secondary Button' %}
                    {% render 'ui-button', variant: 'cta', cta_size: 'sm', content: 'CTA Button' %}
                    {% render 'ui-button', variant: 'ghost', content: 'Ghost Button' %}
                    {% render 'ui-button', variant: 'danger', content: 'Danger Button' %}
                    {% render 'ui-button', variant: 'link', href: '#', content: 'Link Button' %}
                    {% render 'ui-button',
                        variant: 'icon-only',
                        type: 'button',
                        icon_name: 'material-symbols:expand-circle-up',
                        button_icon_size: '2.0rem',
                        button_icon_color: 'text-white',
                        button_icon_hover_color: 'group-hover/button:text-brand-blue',
                        icon_bg: true,
                        icon_bg_size_class: 'h-7 w-7',
                        icon_bg_class: 'bg-brand-blue translate-y-[-0.35px] translate-x-[-0.35px]',
                        icon_bg_hover_class: 'group-hover/button:bg-white',
                        button_icon_wrap_class: 'h-7 w-7',
                    %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Inline Links</h3>
                <div class="flex flex-col items-start gap-6">
                    <p>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Distinctio ipsum laboriosam recusandae cumque officiis, {% render 'ui-link', href: '#', label: 'Internal Link' %} tempore earum. Quam cum sed delectus!
                    </p>

                    <p>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Distinctio ipsum laboriosam recusandae cumque officiis, {% render 'ui-link', href: '#', variant: 'muted', label: 'Internal Link' %} tempore earum. Quam cum sed delectus!
                    </p>

                    <p>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Distinctio ipsum laboriosam recusandae cumque officiis, {% render 'ui-link', href: 'https://external.com/#', type: 'external', label: 'External Link' %} tempore earum. Quam cum sed delectus!
                    </p>

                    <p>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Distinctio ipsum laboriosam recusandae cumque officiis, {% render 'ui-link', href: 'https://external.com/#', variant: 'muted', type: 'external', label: 'External Link' %} tempore earum. Quam cum sed delectus!
                    </p>
                </div>
            </div>
            <div class="space-y-4">
                <h3>Badges</h3>
                <div>
                    {% render 'ui-badge', label: cart.item_count %}
                    {% render 'ui-badge', variant: 'success', label: cart.item_count %}
                    {% render 'ui-badge', variant: 'warning', label: cart.item_count %}
                    {% render 'ui-badge', variant: 'danger' label: cart.item_count %}
                    {% render 'ui-badge', variant: 'info' label: cart.item_count %}
                </div>
                <div>
                    {% render 'ui-badge', size: 'md', label: cart.item_count %}
                    {% render 'ui-badge', size: 'md', variant: 'success', label: cart.item_count %}
                    {% render 'ui-badge', size: 'md', variant: 'warning', label: cart.item_count %}
                    {% render 'ui-badge', size: 'md', variant: 'danger' label: cart.item_count %}
                    {% render 'ui-badge', size: 'md', variant: 'info' label: cart.item_count %}
                </div>
                <div>
                    {% render 'ui-badge', size: 'lg', label: cart.item_count %}
                    {% render 'ui-badge', size: 'lg', variant: 'success', label: 99099 %}
                    {% render 'ui-badge', size: 'lg', variant: 'warning', label: cart.item_count %}
                    {% render 'ui-badge', size: 'lg', variant: 'danger' label: cart.item_count %}
                    {% render 'ui-badge', size: 'lg', variant: 'info' label: cart.item_count %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Tag</h3>
                <div>
                    {% render 'ui-tag', label: 'Sale', param: 'filter.v.price' %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Cards</h3>
                <div>
                    {% render 'ui-card',
                        title: 'Default Card',
                        subtitle: "Donec nisi sem, tincidunt sit amet finibus at.",
                        content: "<p class='text-sm'>Donec nisi sem, tincidunt sit amet finibus at, faucibus sit amet massa. Proin odio mauris, fermentum sit amet diam vitae, efficitur porttitor felis. Morbi sollicitudin felis at ante lobortis varius. </p>"
                    %}
                </div>
                <div>
                    {% render 'ui-card',
                        size: 'lg',
                        variant: 'shadowed',
                        title: 'Large padding - shadowed - card',
                        subtitle: "Donec nisi sem, tincidunt sit amet finibus at.",
                        content: "<p class='text-sm'>Donec nisi sem, tincidunt sit amet finibus at, faucibus sit amet massa. Proin odio mauris, fermentum sit amet diam vitae, efficitur porttitor felis. Morbi sollicitudin felis at ante lobortis varius. </p>"
                    %}
                </div>
                <div>
                    {% render 'ui-card',
                        size: 'fit',
                        variant: 'outlined',
                        title: 'Fitted - outlined - card',
                        content: '<p class="text-sm">Donec nisi sem</p>'
                    %}
                </div>
                <div>
                    {% render 'ui-card',
                        size: 'fit',
                        variant: 'shadowed',
                        title: 'Fitted - shadowed - card',
                        content: '<p class="text-sm">Donec nisi sem</p>'
                    %}
                </div>
                <div>
                    {% render 'ui-card', 
                        size: 'md',
                        variant: 'soft'
                        title: 'Medium padding - soft - card',
                        subtitle: "Donec nisi sem, tincidunt sit amet finibus at.",
                        content: "<p class='text-sm'>Donec nisi sem, tincidunt sit amet finibus at, faucibus sit amet massa. Proin odio mauris, fermentum sit amet diam vitae, efficitur porttitor felis. Morbi sollicitudin felis at ante lobortis varius. </p>"
                    %}
                </div>
                <div>
                    {% render 'ui-card',
                        variant: 'attention',
                        size: 'fit',
                        title: 'Please Note',
                        subtitle: 'Complete this step before continuing.',
                        content: "<p class='text-sm'>If you need help, contact us and we'll walk you through it.</p>"
                    %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Dividers</h3>
                <div class="space-y-4">
                    {% render 'ui-divider', size: 'md' %}
                    
                    {% render 'ui-divider', variant: 'soft', size: 'md' %}

                    {% render 'ui-divider', variant: 'dash', size: 'md' %}

                    {% render 'ui-divider', variant: 'label', size: 'md', label: 'Labeled Divider' %}
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <h2>Form Systems</h2>
            <div class="space-y-4">
                <h3>Inputs</h3>
                <div class="space-y-6">
                    <div>
                        <h4>Stacked Fields</h4>
                        <div>
                            {% form 'contact' %}
                                {% capture form_markup %}
                                    <div>
                                        {% render 'form-input', type: 'text', name: 'text-input', required: true, placeholder: 'Text Input', label: 'Text Input', no_validate: true %}
                                    </div>
    
                                    <div>
                                        {% render 'form-input', type: 'email', name: 'contact[email]', help: 'Enter an email', required: true, placeholder: 'example@email.com', label: 'Email Input', autocomplete: 'email' %}
                                    </div>
    
                                    <div>
                                        {% render 'form-input', type: 'phone', name: 'contact[phone]', placeholder: 'Phone Input', label: 'Phone Input', autocomplete: 'tel' %}
                                    </div>
    
                                    <div>
                                        {% render 'form-input', type: 'number', name: 'contact[number]', placeholder: 'Number Input', label: 'Number Input' %}
                                    </div>
    
                                    <div>
                                        {% render 'form-input', type: 'password', name: 'contact[password]', required: true, no_validate: true, placeholder: 'Password Input', label: 'Password Input' %}
                                    </div>
                                {% endcapture %}
    
                                {% render 'form-container',
                                    enable_live_validation: true,
                                    layout: 'stack',
                                    content: form_markup,
                                    class: 'w-1/2'
                                %}
                            {% endform %}
                        </div>
                    </div>
                    <div>
                        <h4>Inline Fields</h4>
                        <div>
                            {% form 'contact' %}
                                {% capture form_markup %}
                                    <div class="w-1/4">
                                        {% render 'form-input', type: 'text', name: 'text-input', required: true, placeholder: 'Text Input', label: 'Text Input', no_validate: true %}
                                    </div>
    
                                    <div>
                                        {% render 'form-input', type: 'email', name: 'contact[email]', help: 'Enter an email', required: true, placeholder: 'example@email.com', label: 'Email Input', autocomplete: 'email' %}
                                    </div>
    
                                    <div>
                                        {% render 'form-input', type: 'phone', name: 'contact[phone]', placeholder: 'Phone Input', label: 'Phone Input', autocomplete: 'tel' %}
                                    </div>
    
                                    <div>
                                        {% render 'form-input', type: 'number', name: 'contact[number]', placeholder: 'Number Input', label: 'Number Input' %}
                                    </div>
    
                                    <div>
                                        {% render 'form-input', type: 'password', name: 'contact[password]', required: true, no_validate: true, placeholder: 'Password Input', label: 'Password Input' %}
                                    </div>
                                {% endcapture %}
    
                                {% render 'form-container',
                                    enable_live_validation: true,
                                    layout: 'inline',
                                    content: form_markup,
                                %}
                            {% endform %}
                        </div>
                    </div>

    
                    <div class="w-1/2">
                        <label for="{{ _id }}" class="font-extrabold text-xs inline-block text-brand-blue capitalize">Search Bar</label>
                        {% render 'form-search', placeholder: 'Search…' %}
                    </div>
                </div>
            </div>
            <div class="space-y-4">
                <h3>Textarea</h3>
                {% capture form_markup_textarea %}
                    {% form 'contact' %}
                        <div class="w-1/2">
                            {% render 'form-textarea', label: 'Text Area', placeholder: 'Extra text', help: 'Textarea helper example', required: true %}
                        </div>
                    {% endform %}
                {% endcapture %}

                {% render 'form-container',
                    enable_live_validation: true,
                    content: form_markup_textarea
                %}
            </div>
            <div class="space-y-4">
                <h3>Select</h3>
                {% capture form_markup_select %}
                    {% form 'contact' %}
                        <div class="w-1/2">
                            {% render 'form-select', name: 'select-input', placeholder: 'Select an Option', options: '<option>Option 1</option><option>Option 2</option>', label: 'Option Select' %}
                        </div>
                    {% endform %}
                {% endcapture %}

                {% render 'form-container',
                    enable_live_validation: true,
                    content: form_markup_select
                %}
            </div>
            <div class="space-y-4">
                <h3>Combobox</h3>
                <div class="w-1/2">
                    {% assign states = "co|Colorado,wy|Wyoming,ut|Utah" | split: ',' %}

                    {% render 'form-combobox',
                        name: 'state',
                        label: 'State',
                        help: 'Start typing to filter.',
                        placeholder: 'Select a state…',
                        options: states,
                        value: 'co'
                    %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Checkbox</h3>
                <div>
                    {% render 'form-checkbox', name: 'agree', heading_label: 'Attestation', required: true, label: 'I agree to the terms', checked: true %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Radio</h3>
                <div>
                    {% capture radios %}
                        {% render 'form-radio', name: 'contact[reason]', value: 'billing', label: 'Billing', checked_value: form.reason, checked: true %}
                        {% render 'form-radio', name: 'contact[reason]', value: 'order', label: 'Order status', checked_value: form.reason %}
                        {% render 'form-radio', name: 'contact[reason]', value: 'other', label: 'Other', checked_value: form.reason %}
                    {% endcapture %}

                    {% render 'form-radio-group',
                        name: 'contact[reason]',
                        label: 'Reason for contact',
                        help: 'Pick the option that best fits your request.',
                        required: true,
                        layout: 'stack',
                        content: radios
                    %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Toggle/switch</h3>
                <div>
                    {% render 'form-toggle', name: 'subscribe', heading_label: 'Marketing', label: 'Subscribe to emails', required: true, checked: false %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Stepper</h3>
                <div class="w-1/8">
                    {% render 'form-stepper', name: 'quantity', heading_label: 'Quantity Stepper', label: 'Quantity', value: 1, min: 1, max: 20, step: 1 %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Helper Text</h3>
                <div>
                    {% render 'form-helper', text: 'Lorem ipsum dolor sit amet consectetur adipisicing elit. Id eum neque aliquid sapiente. Minima, perferendis.' %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Error Text</h3>
                <div>
                    {% render 'form-error', text: 'Lorem ipsum dolor sit amet consectetur adipisicing elit. Id eum neque aliquid sapiente. Minima, perferendis.' %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Fieldset + Legend</h3>
                <div>
                    {% form 'contact' %}
                        {% capture form_markups %}
                            {% capture radios %}
                                <div>
                                    {% render 'form-radio', name: 'contact[preference]', value: 'email', label: 'Email' %}
                                    {% render 'form-radio', name: 'contact[preference]', value: 'phone', label: 'Phone' %}
                                </div>
                            {% endcapture %}
                            {% render 'form-fieldset', legend: 'Preferred contact', content: radios %}
                            <div class="mt-4 w-1/2">
                                {% render 'form-input', type: 'password', name: 'contact[password]', required: true, no_validate: true, placeholder: 'Password Input', label: 'Password Input' %}
                            </div>

                        {% endcapture %}

                        {% render 'form-container', layout: 'stack', content: form_markups %}
                    {% endform %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Validation States</h3>
                <div>
                    {% form 'contact' %}
                        {% capture validation_states %}

                                {% render 'form-input', name: 'validation_default', type: 'text', label: 'Default State' %}
                                {% render 'form-input', name: 'validation_error', type: 'text', label: 'Error State', error: 'Error state trigger' %}
                                {% render 'form-input', name: 'validation_success', type: 'text', label: 'Success State', success: 'Success state trigger' %}
                                {% render 'form-input', name: 'validation_focus', type: 'text', label: 'Focus State', class: 'border-2 border-brand-blue shadow-interior' %}
                                {% render 'form-input', name: 'validation_disabled', type: 'text', label: 'Disabled State', disabled: true %}
                        {% endcapture %}

                        {%  render 'form-container', layout: 'stack',  content: validation_states, class: 'w-1/2' %}
                    {% endform %}
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <h2>Navigation Components</h2>
            <div class="space-y-4">
                <h3>Logo / Brand Slot</h3>
                <div>
                    {% render 'ui-logo-lockup', class: 'w-32 ml-6', animated: false %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Logo / Brand Slot (flat only)</h3>
                <div>
                    {% render 'ui-logo-lockup', class: 'w-32 ml-6', flat_only: true %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Primary Nav Bar</h3>
                <div>
                    {% render 'primary-nav-links', menu: section.settings.menu %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Dropdown Menu</h3>
                <div>
                    {% capture dropdown_trigger %}
                        <span>Sample Dropdown</span>
                        {% render 'ui-icon', name: 'chevron-down', size: '1rem', class: 'inline-flex shrink-0 transition-transform duration-200 group-open/nav:rotate-180 text-muted', decorative: true %}
                    {% endcapture %}
                    {% capture dropdown_panel %}
                        <ul role="list" class="flex flex-col gap-1">
                            <li><a href="#" class="block rounded-lg px-3 py-2 text-sm font-semibold text-text no-underline hover:bg-button-hover hover:text-link">Link One</a></li>
                            <li><a href="#" class="block rounded-lg px-3 py-2 text-sm font-semibold text-text no-underline hover:bg-button-hover hover:text-link">Link Two</a></li>
                            <li><a href="#" class="block rounded-lg px-3 py-2 text-sm font-semibold text-text no-underline hover:bg-button-hover hover:text-link">Link Three</a></li>
                        </ul>
                    {% endcapture %}
                    {% render 'ui-dropdown', trigger: dropdown_trigger, panel: dropdown_panel %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Mega Menu</h3>
                <div>
                    {% render 'ui-mega-menu-collections', label: 'Products', menu: section.settings.menu %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Mobile Nav</h3>
                <div class="border border-border rounded-lg p-4 bg-surface max-w-sm">
                    <div class="flex items-center justify-between mb-4">
                        {% render 'ui-logo-lockup', class: 'w-24', flat_only: true %}
                        <button type="button" class="cursor-pointer inline-flex items-center justify-center rounded-md p-2 text-text hover:bg-button-hover hover:text-link" aria-label="Close menu">
                            {% render 'ui-icon', name: 'cancel', size: '1.5rem', class: 'text-base-icon', decorative: true %}
                        </button>
                    </div>
                    <nav class="flex flex-col gap-1">
                        <a href="#" class="block rounded-lg px-3 py-2 text-sm font-bold text-text no-underline hover:bg-button-hover hover:text-link">Home</a>
                        <a href="#" class="block rounded-lg px-3 py-2 text-sm font-bold text-brand-burgundy bg-button-hover no-underline">Products</a>
                        <a href="#" class="block rounded-lg px-3 py-2 text-sm font-bold text-text no-underline hover:bg-button-hover hover:text-link">About</a>
                        <a href="#" class="block rounded-lg px-3 py-2 text-sm font-bold text-text no-underline hover:bg-button-hover hover:text-link">Contact</a>
                    </nav>
                </div>
            </div>
            <div class="space-y-4">
                <h3>Mobile nav accordion items</h3>
                <div class="max-w-sm">
                    {% capture accordion_trigger %}
                        <span>Products</span>
                        {% render 'ui-icon', name: 'chevron-down', size: '1rem', class: 'inline-flex shrink-0 transition-transform duration-200 group-open/nav:rotate-180 text-muted', decorative: true %}
                    {% endcapture %}
                    {% capture accordion_panel %}
                        <ul role="list" class="flex flex-col gap-1 pl-3">
                            <li><a href="#" class="block rounded-lg px-3 py-2 text-sm font-semibold text-text no-underline hover:bg-button-hover hover:text-link">Wound Care</a></li>
                            <li><a href="#" class="block rounded-lg px-3 py-2 text-sm font-semibold text-text no-underline hover:bg-button-hover hover:text-link">Diagnostics</a></li>
                            <li><a href="#" class="block rounded-lg px-3 py-2 text-sm font-semibold text-text no-underline hover:bg-button-hover hover:text-link">PPE</a></li>
                            <li><a href="#" class="block rounded-lg px-3 py-2 text-sm font-semibold text-text no-underline hover:bg-button-hover hover:text-link">Furniture</a></li>
                        </ul>
                    {% endcapture %}
                    {% render 'ui-dropdown',
                        trigger: accordion_trigger,
                        panel: accordion_panel,
                        details_class: 'group/nav',
                        summary_class: 'group/trigger list-none cursor-pointer select-none rounded-lg px-3 py-2 text-sm font-bold text-text no-underline hover:bg-button-hover hover:text-link flex items-center justify-between gap-2 w-full',
                        panel_class: 'py-1'
                    %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Skip to content Link</h3>
                <div>
                    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:rounded-md focus:bg-brand-blue focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white focus:outline-none focus:ring-2 focus:ring-focus focus:ring-offset-2">Skip to content</a>
                    <p class="text-sm text-muted">Tab into this area to reveal the skip link.</p>
                </div>
            </div>
            <div class="space-y-4">
                <h3>Cart Trigger</h3>
                <div>
                    {% render 'ui-cart-drawer' %}
                </div>
            </div>
            {% comment %} <div class="space-y-4">
                <h3>Account Trigger</h3>
            </div>
            <div class="space-y-4">
                <h3>Wishlist Trigger</h3>
            </div>
            <div class="space-y-4">
                <h3>Language Selector</h3>
            </div> {% endcomment %}
        </div>
        <div class="space-y-6">
            <h2>Alert / Callout Components</h2>

            <div class="space-y-4">
                <h3>Inline Alerts</h3>

                <div class="space-y-4">
                {% render 'ui-alert',
                    variant: 'info',
                    mode: 'inline',
                    title: 'General information',
                    message: 'This is a neutral informational alert for guidance, notices, or general communication.'
                %}

                {% render 'ui-alert',
                    variant: 'success',
                    mode: 'inline',
                    title: 'Success message',
                    message: 'Your changes were saved successfully and everything completed as expected.'
                %}

                {% render 'ui-alert',
                    variant: 'warning',
                    mode: 'inline',
                    title: 'Warning message',
                    message: 'Please review this section before continuing because some selections may affect the outcome.'
                %}

                {% render 'ui-alert',
                    variant: 'danger',
                    mode: 'inline',
                    title: 'Danger message',
                    message: 'We could not complete your request at this time. Please correct the issue and try again.'
                %}

                {% render 'ui-alert',
                    variant: 'cart',
                    mode: 'inline',
                    title: 'Cart updated',
                    message: '1 item was added to your cart.',
                    action_label: 'View cart',
                    action_url: routes.cart_url
                %}
                </div>
            </div>

            <div class="space-y-4">
                <h3>Compact Inline Alerts</h3>

                <div class="space-y-4">
                {% render 'ui-alert',
                    variant: 'info',
                    mode: 'inline',
                    title: 'Compact info',
                    message: 'A smaller neutral alert.',
                    compact: true
                %}

                {% render 'ui-alert',
                    variant: 'success',
                    mode: 'inline',
                    title: 'Compact success',
                    message: 'Saved successfully.',
                    compact: true
                %}

                {% render 'ui-alert',
                    variant: 'warning',
                    mode: 'inline',
                    title: 'Compact warning',
                    message: 'Please double-check this setting.',
                    compact: true
                %}

                {% render 'ui-alert',
                    variant: 'danger',
                    mode: 'inline',
                    title: 'Compact danger',
                    message: 'Something went wrong.',
                    compact: true
                %}

                {% render 'ui-alert',
                    variant: 'cart',
                    mode: 'inline',
                    title: 'Compact cart',
                    message: 'Cart quantity updated.',
                    compact: true,
                    action_label: 'View cart',
                    action_url: routes.cart_url
                %}
                </div>
            </div>

            <div class="space-y-4">
                <h3>Toast Style Examples</h3>

                <div class="space-y-4">
                {% render 'ui-alert',
                    variant: 'info',
                    mode: 'toast',
                    title: 'Toast info',
                    message: 'This is how an informational toast will look.',
                    dismissible: true,
                    compact: true
                %}

                {% render 'ui-alert',
                    variant: 'success',
                    mode: 'toast',
                    title: 'Toast success',
                    message: 'Your action completed successfully.',
                    dismissible: true,
                    compact: true
                %}

                {% render 'ui-alert',
                    variant: 'warning',
                    mode: 'toast',
                    title: 'Toast warning',
                    message: 'You may want to review this item.',
                    dismissible: true,
                    compact: true
                %}

                {% render 'ui-alert',
                    variant: 'danger',
                    mode: 'toast',
                    title: 'Toast danger',
                    message: 'We could not complete that action.',
                    dismissible: true,
                    compact: true
                %}

                {% render 'ui-alert',
                    variant: 'cart',
                    mode: 'toast',
                    title: 'Toast cart',
                    message: '1 item was added to your cart.',
                    dismissible: true,
                    compact: true,
                    action_label: 'View cart',
                    action_url: routes.cart_url
                %}
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <h2>Inline Note Components</h2>

            <div class="space-y-4">
                <h3>Please Note</h3>

                <div class="space-y-3">
                {% render 'ui-note-inline',
                    content: 'Insurance coverage may vary by payer and documentation.'
                %}

                {% render 'ui-note-inline',
                    content: 'Product availability may change without notice.'
                %}

                {% render 'ui-note-inline',
                    content: 'This item may require additional documentation before fulfillment.',
                    class: 'text-sm'
                %}

                {% render 'ui-note-inline',
                    label: 'Important:',
                    content: 'Some products may ship separately depending on stock availability.'
                %}
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <h2>Loading Components</h2>

            <div class="space-y-4">
                <h3>Inline Loading Indicator</h3>

                <div class="space-y-4">
                <div class="flex items-center gap-3">
                    <span class="text-sm text-muted">Extra small</span>
                    {% render 'ui-loading-inline', size: 'xs' %}
                </div>

                <div class="flex items-center gap-3">
                    <span class="text-sm text-muted">Small</span>
                    {% render 'ui-loading-inline', size: 'sm' %}
                </div>

                <div class="flex items-center gap-3">
                    <span class="text-sm text-muted">Medium</span>
                    {% render 'ui-loading-inline', size: 'md' %}
                </div>

                <div class="flex items-center gap-3">
                    <span class="text-sm text-muted">Large</span>
                    {% render 'ui-loading-inline', size: 'lg' %}
                </div>

                <div class="flex items-center gap-3">
                    <span class="text-sm text-muted">Brand burgundy</span>
                    {% render 'ui-loading-inline', size: 'md', spinner_class: 'text-brand-burgundy' %}
                </div>

                <div class="rounded-card border border-border bg-surface p-6">
                    {% render 'ui-loading-inline', size: 'lg', centered: true %}
                </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <h2>Skeleton Components</h2>

            <div class="space-y-4">
                <h3>Text Skeleton</h3>

                <div class="space-y-4 rounded-card border border-border bg-surface p-4">
                {% render 'ui-skeleton', mode: 'text', lines: 4 %}
                {% render 'ui-skeleton', mode: 'text', lines: 6 %}
                </div>
            </div>

            <div class="space-y-4">
                <h3>Card Skeleton</h3>

                <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {% render 'ui-skeleton', mode: 'card', variant: 'base' %}
                {% render 'ui-skeleton', mode: 'card', variant: 'base' %}
                {% render 'ui-skeleton', mode: 'card', variant: 'base' %}
                </div>
            </div>

            <div class="space-y-4">
                <h3>Image Skeleton</h3>

                <div class="grid gap-4 md:grid-cols-2">
                {% render 'ui-skeleton', mode: 'image', variant: 'base', aspect_class: 'aspect-video' %}
                {% render 'ui-skeleton', mode: 'image', variant: 'base', aspect_class: 'aspect-square' %}
                </div>
            </div>

            <div class="space-y-4">
                <h3>Product Skeleton</h3>

                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {% render 'ui-skeleton', mode: 'product', variant: 'base' %}
                {% render 'ui-skeleton', mode: 'product', variant: 'base' %}
                {% render 'ui-skeleton', mode: 'product', variant: 'base' %}
                {% render 'ui-skeleton', mode: 'product', variant: 'base' %}
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <h2>Drawer Components</h2>
            <div class="flex flex-wrap gap-3">
                <button type="button" class="inline-flex items-center justify-center rounded-md bg-brand-blue px-4 py-2 text-sm font-bold text-white hover:bg-brand-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-surface" data-drawer-open="DevRightDrawer" aria-controls="DevRightDrawer" aria-expanded="false">
                Open Right Drawer
                </button>

                <button type="button" class="inline-flex items-center justify-center rounded-md border border-border bg-surface px-4 py-2 text-sm font-bold text-text hover:bg-button-hover hover:text-link focus:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-surface" data-drawer-open="DevLeftDrawer" aria-controls="DevLeftDrawer" aria-expanded="false">
                Open Left Drawer
                </button>
            </div>

            {% capture dev_right_body %}
                <div class="flex h-full flex-col">
                <div class="flex-1 overflow-auto px-gutter py-4">
                    <div class="space-y-4">
                    <p class="text-sm text-text">This is a reusable right-side drawer shell.</p>
                    {% render 'ui-note-inline', content: 'This drawer is using the shared overlay foundation.' %}
                    {% render 'ui-skeleton', mode: 'text', lines: 4 %}
                    </div>
                </div>
                <div class="shrink-0 border-t border-border px-gutter py-4">
                    <div class="grid grid-cols-2 gap-2">
                    <button type="button" class="inline-flex items-center justify-center rounded-md border border-border bg-surface px-4 py-2 text-sm font-bold text-text hover:bg-button-hover hover:text-link focus:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-surface" data-drawer-close>
                        Cancel
                    </button>
                    <button type="button" class="inline-flex items-center justify-center rounded-md bg-brand-blue px-4 py-2 text-sm font-bold text-white hover:bg-brand-burgundy focus:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-surface">
                        Confirm
                    </button>
                    </div>
                </div>
                </div>
            {% endcapture %}

            {% render 'ui-drawer',
                id: 'DevRightDrawer',
                side: 'right',
                title: 'Right Drawer',
                body_content: dev_right_body
            %}

            {% capture dev_left_header %}
                <div class="flex items-center">
                {% render 'ui-logo-lockup', animated: false, class: 'w-32', flat_only: true %}
                </div>
            {% endcapture %}

            {% capture dev_left_body %}
                <div class="flex-1 overflow-auto px-gutter py-4">
                <div class="space-y-3">
                    <a href="#" class="block rounded-lg px-3 py-3 text-sm font-bold text-text no-underline hover:bg-button-hover hover:text-link">Home</a>
                    <a href="#" class="block rounded-lg px-3 py-3 text-sm font-bold text-text no-underline hover:bg-button-hover hover:text-link">Products</a>
                    <a href="#" class="block rounded-lg px-3 py-3 text-sm font-bold text-text no-underline hover:bg-button-hover hover:text-link">About</a>
                    <a href="#" class="block rounded-lg px-3 py-3 text-sm font-bold text-text no-underline hover:bg-button-hover hover:text-link">Contact</a>
                </div>
                </div>
            {% endcapture %}

            {% render 'ui-drawer',
                id: 'DevLeftDrawer',
                side: 'left',
                width_class: 'w-[min(22rem,calc(100vw-2rem))]',
                header_content: dev_left_header,
                body_content: dev_left_body
            %}
        </div>

        <div class="space-y-6">
            <h2>Modal Components</h2>

            <div class="flex flex-wrap gap-3">
                {% render 'ui-button',
                label: 'Open Basic Modal',
                variant: 'primary',
                type: 'button',
                class: 'text-sm font-bold',
                attrs: 'data-modal-open="DevModalBasic" aria-controls="DevModalBasic" aria-expanded="false"'
                %}

                {% render 'ui-button',
                label: 'Open Confirm Modal',
                variant: 'secondary',
                type: 'button',
                class: 'text-sm font-bold',
                attrs: 'data-modal-open="DevModalConfirm" aria-controls="DevModalConfirm" aria-expanded="false"'
                %}
            </div>

            {% capture modal_body_basic %}
                <div class="space-y-4 px-gutter py-4">
                <p class="text-sm text-text">This is a reusable modal shell using the shared overlay modal controller.</p>
                {% render 'ui-note-inline', content: 'Use this for focused dialogs, confirmations, notices, or small forms.' %}
                </div>
            {% endcapture %}

            {% render 'ui-modal',
                id: 'DevModalBasic',
                title: 'Basic Modal',
                body_content: modal_body_basic
            %}

            {% capture modal_body_confirm %}
                <div class="space-y-4 px-gutter py-4">
                <p class="text-sm text-text">Are you sure you want to continue with this action?</p>
                {% render 'ui-alert',
                    variant: 'warning',
                    mode: 'inline',
                    title: 'Please review',
                    message: 'This is a sample confirmation modal using your shared component system.',
                    compact: true
                %}
                </div>
            {% endcapture %}

            {% capture modal_footer_confirm %}
                <div class="grid grid-cols-2 gap-2 px-gutter py-4">
                {% render 'ui-button',
                    label: 'Cancel',
                    variant: 'secondary',
                    type: 'button',
                    class: 'w-full text-sm font-bold',
                    attrs: 'data-modal-close'
                %}
                {% render 'ui-button',
                    label: 'Confirm',
                    variant: 'primary',
                    type: 'button',
                    class: 'w-full text-sm font-bold'
                %}
                </div>
            {% endcapture %}

            {% render 'ui-modal',
                id: 'DevModalConfirm',
                title: 'Confirm Action',
                size_class: 'max-w-xl',
                body_content: modal_body_confirm,
                footer_content: modal_footer_confirm
            %}
        </div>

        {% comment %} <div class="space-y-12">
        <h2>Overlays & Disclosures</h2>
        <div class="space-y-4">
            <h3>Modal (generic)</h3>
        </div>
        <div class="space-y-4">
            <h3>Drawer / Side panel (generic)</h3>
        </div>
        <div class="space-y-4">
            <h3>Popover</h3>
        </div>
        <div class="space-y-4">
            <h3>Tooltip</h3>
        </div>
        <div class="space-y-4">
            <h3>Backdrop</h3>
        </div>
    </div> {% endcomment %}

    {% comment %} <div class="space-y-12">
        <h2>Interaction State Standards</h2>
        <div class="space-y-4">
            <h3>Hover States</h3>
        </div>
        <div class="space-y-4">
            <h3>Focus-visible States</h3>
        </div>
        <div class="space-y-4">
            <h3>Active/Pressed States</h3>
        </div>
        <div class="space-y-4">
            <h3>Disabled States</h3>
        </div>
        <div class="space-y-4">
            <h3>Error States</h3>
        </div>
    </div> {% endcomment %}
    {% endcapture %}
    {% render 'layout-section', bg: 'page', content: body %}
</div>