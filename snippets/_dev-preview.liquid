<div>
    {% capture body %}
        <div>
            <h1>Global UI</h1>
            <hr class="mb-4">
        </div>
        <div class="space-y-12">
            <h2>UI Primatives</h2>
            <div class="space-y-4">
                <h3>Buttons</h3>
                <div class="flex flex-col items-start gap-6">
                    {% render 'ui-button', variant: 'primary', content: 'Primary Button' %}
                    {% render 'ui-button', variant: 'secondary', content: 'Secondary Button' %}
                    {% render 'ui-button', variant: 'cta', cta_size: 'sm', content: 'CTA Button' %}
                    {% render 'ui-button', variant: 'ghost', content: 'Ghost Button' %}
                    {% render 'ui-button', variant: 'danger', content: 'Danger Button' %}
                    {% render 'ui-button', variant: 'link', href: '#', content: 'Link Button' %}
                    {% render 'ui-button', variant: 'icon-only', content: 'icon-only Button' %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Inline Links</h3>
                <div class="flex flex-col items-start gap-6">
                    <p>
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Distinctio ipsum laboriosam recusandae cumque officiis, {% render 'ui-link', href: '#', content: 'Internal Link' %} tempore earum. Quam cum sed delectus!
                    </p>
                    <p>
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Distinctio ipsum laboriosam recusandae cumque officiis, {% render 'ui-link', href: '#', variant: 'muted', content: 'Internal Link' %} tempore earum. Quam cum sed delectus!
                    </p>
                    <p>
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Distinctio ipsum laboriosam recusandae cumque officiis, {% render 'ui-link', href: '#', type: 'external', content: 'External Link' %} tempore earum. Quam cum sed delectus!                 
                    </p>
                    <p>
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Distinctio ipsum laboriosam recusandae cumque officiis, {% render 'ui-link', href: '#', variant: 'muted', type: 'external', content: 'External Link' %} tempore earum. Quam cum sed delectus!    
                    </p>
                </div>
            </div>
            <div class="space-y-4">
                <h3>Badges</h3>
                <div>
                    {% render 'ui-badge', label: cart.item_count %}
                    {% render 'ui-badge', variant: 'success', label: cart.item_count %}
                    {% render 'ui-badge', variant: 'warning', label: cart.item_count %}
                    {% render 'ui-badge', variant: 'danger' label: cart.item_count %}
                    {% render 'ui-badge', variant: 'info' label: cart.item_count %}
                </div>
                <div>
                    {% render 'ui-badge', size: 'md', label: cart.item_count %}
                    {% render 'ui-badge', size: 'md', variant: 'success', label: cart.item_count %}
                    {% render 'ui-badge', size: 'md', variant: 'warning', label: cart.item_count %}
                    {% render 'ui-badge', size: 'md', variant: 'danger' label: cart.item_count %}
                    {% render 'ui-badge', size: 'md', variant: 'info' label: cart.item_count %}
                </div>
                <div>
                    {% render 'ui-badge', size: 'lg', label: cart.item_count %}
                    {% render 'ui-badge', size: 'lg', variant: 'success', label: 99099 %}
                    {% render 'ui-badge', size: 'lg', variant: 'warning', label: cart.item_count %}
                    {% render 'ui-badge', size: 'lg', variant: 'danger' label: cart.item_count %}
                    {% render 'ui-badge', size: 'lg', variant: 'info' label: cart.item_count %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Tag</h3>
                <div>
                    {% render 'ui-tag', label: 'Sale', param: 'filter.v.price' %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Cards</h3>
                <div>
                    {% render 'ui-card',
                        title: 'Default Card',
                        subtitle: "Donec nisi sem, tincidunt sit amet finibus at.",
                        content: "<p class='text-sm'>Donec nisi sem, tincidunt sit amet finibus at, faucibus sit amet massa. Proin odio mauris, fermentum sit amet diam vitae, efficitur porttitor felis. Morbi sollicitudin felis at ante lobortis varius. </p>"
                    %}
                </div>
                <div>
                    {% render 'ui-card',
                        size: 'lg',
                        variant: 'shadowed',
                        title: 'Large padding - shadowed - card',
                        subtitle: "Donec nisi sem, tincidunt sit amet finibus at.",
                        content: "<p class='text-sm'>Donec nisi sem, tincidunt sit amet finibus at, faucibus sit amet massa. Proin odio mauris, fermentum sit amet diam vitae, efficitur porttitor felis. Morbi sollicitudin felis at ante lobortis varius. </p>"
                    %}
                </div>
                <div>
                    {% render 'ui-card',
                        size: 'fit',
                        variant: 'outlined',
                        title: 'Fitted - outlined - card',
                        content: '<p class="text-sm">Donec nisi sem</p>'
                    %}
                </div>
                <div>
                    {% render 'ui-card',
                        size: 'fit',
                        variant: 'shadowed',
                        title: 'Fitted - shadowed - card',
                        content: '<p class="text-sm">Donec nisi sem</p>'
                    %}
                </div>
                <div>
                    {% render 'ui-card', 
                        size: 'md',
                        variant: 'soft'
                        title: 'Medium padding - soft - card',
                        subtitle: "Donec nisi sem, tincidunt sit amet finibus at.",
                        content: "<p class='text-sm'>Donec nisi sem, tincidunt sit amet finibus at, faucibus sit amet massa. Proin odio mauris, fermentum sit amet diam vitae, efficitur porttitor felis. Morbi sollicitudin felis at ante lobortis varius. </p>"
                    %}
                </div>
                <div>
                    {% render 'ui-card',
                        variant: 'attention',
                        size: 'fit',
                        title: 'Please Note',
                        subtitle: 'Complete this step before continuing.',
                        content: "<p class='text-sm'>If you need help, contact us and we'll walk you through it.</p>"
                    %}
                </div>
            </div>
            <div class="space-y-4">
                <h3>Dividers</h3>
                <div class="space-y-4">
                    {% render 'ui-divider', size: 'md' %}
                    
                    {% render 'ui-divider', variant: 'soft', size: 'md' %}

                    {% render 'ui-divider', variant: 'dash', size: 'md' %}

                    {% render 'ui-divider', variant: 'label', size: 'md', label: 'Labeled Divider' %}
                </div>
            </div>
        </div>

        <div class="space-y-12">
            <h2>Form Systems</h2>
            <div class="space-y-4">
                <h3>Text/Number Input</h3>
            </div>
            <div class="space-y-4">
                <h3>Textarea</h3>
            </div>
            <div class="space-y-4">
                <h3>Select</h3>
            </div>
            <div class="space-y-4">
                <h3>Combobox</h3>
            </div>
            <div class="space-y-4">
                <h3>Checkbox</h3>
            </div>
            <div class="space-y-4">
                <h3>Radio</h3>
            </div>
            <div class="space-y-4">
                <h3>Toggle/switch</h3>
            </div>
            <div class="space-y-4">
                <h3>Stepper</h3>
            </div>
            <div class="space-y-4">
                <h3>Label</h3>
            </div>
            <div class="space-y-4">
                <h3>Helper Text</h3>
            </div>
            <div class="space-y-4">
                <h3>Error Text</h3>
            </div>
            <div class="space-y-4">
                <h3>Required Indicator</h3>
            </div>
            <div class="space-y-4">
                <h3>Fieldset + Legend</h3>
            </div>
            <div class="space-y-4">
                <h3>For Layout Utilities</h3>
            </div>
            <div class="space-y-4">
                <h3>Validation States</h3>
            </div>
        </div>

        {% comment %} <div class="space-y-12">
            <h2>Navigation Components</h2>
            <div class="space-y-4">
                <h3>Logo / Brand Slot</h3>
            </div>
            <div class="space-y-4">
                <h3>Primary Nav Bar</h3>
            </div>
            <div class="space-y-4">
                <h3>Dropdown Menu</h3>
            </div>
            <div class="space-y-4">
                <h3>Mega Menu</h3>
            </div>
            <div class="space-y-4">
                <h3>Mobile Nav</h3>
            </div>
            <div class="space-y-4">
                <h3>Mobile nav accordion items</h3>
            </div>
            <div class="space-y-4">
                <h3>Active Links</h3>
            </div>
            <div class="space-y-4">
                <h3>Skip to content Link</h3>
            </div>
            <div class="space-y-4">
                <h3>Search Trigger</h3>
            </div>
            <div class="space-y-4">
                <h3>Cart Trigger</h3>
            </div>
            <div class="space-y-4">
                <h3>Account Trigger</h3>
            </div>
            <div class="space-y-4">
                <h3>Wishlist Trigger</h3>
            </div>
            <div class="space-y-4">
                <h3>Language Selector</h3>
            </div>
            <div class="space-y-4">
                <h3>Breadcrumbs</h3>
            </div>
            <div class="space-y-4">
                <h3>Pagination</h3>
            </div>
            <div class="space-y-4">
                <h3>Back Link Pattern</h3>
            </div> {% endcomment %}

        {% comment %} <div class="space-y-12">
            <h2>Header (Global)</h2>
            <div class="space-y-4">
                <h3>Announcement Bar</h3>
            </div>
            <div class="space-y-4">
                <h3>Header Layout (desktop/mobile)</h3>
            </div>
            <div class="space-y-4">
                <h3>Sticky Header</h3>
            </div>
            <div class="space-y-4">
                <h3>Mobile Menu (open/close)</h3>
            </div>
            <div class="space-y-4">
                <h3>Header Search Behavior</h3>
            </div>
            <div class="space-y-4">
                <h3>Cart Count Display</h3>
            </div>
        </div> {% endcomment %}

        {% comment %} <div class="space-y-12">
            <h2>Footer (Global)</h2>
            <div class="space-y-4">
                <h3>Footer Layout grid</h3>
            </div>
            <div class="space-y-4">
                <h3>Footer Link Groups</h3>
            </div>
            <div class="space-y-4">
                <h3>Content Block</h3>
            </div>
            <div class="space-y-4">
                <h3>Social Links</h3>
            </div>
            <div class="space-y-4">
                <h3>Newsletter Signup</h3>
            </div>
            <div class="space-y-4">
                <h3>Legal Row</h3>
            </div>
            <div class="space-y-4">
                <h3>Payment Icons Row</h3>
            </div>
            <div class="space-y-4">
                <h3>Back to Top Button</h3>
            </div> {% endcomment %}

            {% comment %} <div class="space-y-12">
                <h2>Overlays & Disclosures</h2>
                <div class="space-y-4">
                    <h3>Modal (generic)</h3>
                </div>
                <div class="space-y-4">
                    <h3>Drawer / Side panel (generic)</h3>
                </div>
                <div class="space-y-4">
                    <h3>Popover</h3>
                </div>
                <div class="space-y-4">
                    <h3>Tooltip</h3>
                </div>
                <div class="space-y-4">
                    <h3>Backdrop</h3>
                </div>
            </div> {% endcomment %}

            {% comment %} <div class="space-y-12">
                <h2>Interaction State Standards</h2>
                <div class="space-y-4">
                    <h3>Hover States</h3>
                </div>
                <div class="space-y-4">
                    <h3>Focus-visible States</h3>
                </div>
                <div class="space-y-4">
                    <h3>Active/Pressed States</h3>
                </div>
                <div class="space-y-4">
                    <h3>Disabled States</h3>
                </div>
                <div class="space-y-4">
                    <h3>Error States</h3>
                </div>
            </div> {% endcomment %}
    {% endcapture %}
    {% render 'layout-section', bg: 'page', content: body %}
</div>