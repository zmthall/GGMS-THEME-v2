{%- comment -%}
  form-helper

  Helper/neutral text under a field.

  Args:
  - id: element id for aria-describedby targeting (optional)
  - text: helper text (required)
  - class: optional classes appended to the <p>
{%- endcomment -%}

{%- liquid
  assign _id = id
  assign _text = text
  assign _class = class | default: ''
-%}

{%- if _text != blank -%}
  <p{% if _id != blank %} id="{{ _id }}"{% endif %} class="mt-1 text-xs font-semibold text-muted {{ _class }}">{{ _text }}</p>
{%- endif -%}