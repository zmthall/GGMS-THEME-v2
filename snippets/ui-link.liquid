{%- comment -%}
  ui-button

  Args:
    - content: HTML string (preferred "slot") OR label fallback
    - type: (internal | external) optional (default: internal)
    - variant: (default | muted)
    - href: string (required; needed for links)

    - aria_label: required if icon-only or no visible text
{% endcomment %}

{%-  liquid 
    assign _content = content | default: ''
    assign _type = type | default: 'internal'
    assign _variant = variant | default: 'default'
    assign _href = href | default: ''

    assign _aria_label = aria_label | default: ''

    assign variant_classes = ''
    case _variant
        when 'muted'
            assign variant_classes = 'text-muted hover:text-link-hover '
    endcase

    assign ring = 'focus-visible:ring-border focus-visible:ring-offset-page '

    assign base = 'inline-flex justify-center items-center gap-1 no-underline '
    
    assign needs_aria = false
    if _variant == 'icon-only'
        assign needs_aria = true
    endif

    assign is_link_missing_href = false
    if _href == blank
        assign is_link_missing_href = true
    endif

    assign classes = base | append: variant_classes | append: ring
%}

{%- if _href != blank -%}
    <a
        href="{{ _href }}"
        class="{{ classes | strip }}"
        {%- if type == 'external' %}
            rel="noopener noreferrer"
            target="_blank"
        {%- endif %}
        {%- if needs_aria and _aria_label != blank -%} aria-label="{{ _aria_label | escape }}"{%- endif -%}
    {%- if _disabled -%}aria-disabled="true" tabindex="-1"{%- endif -%}
    >
        <span class="underline">{{ _content }}</span>
        {%- if type == 'external' -%} 
            <span class="inline-flex no-underline">
                {% render 'ui-icon', name: 'external', size: '1em', class: 'text-inherit' %}
            </span>
        {%- endif -%}
    </a>
{% elsif is_link_missing_href %}
    <span
        after="Missing HREF"
        class="{{ classes | strip }} pointer-events-none opacity-60"
        aria-disabled="true"
    {{ _attrs }}
    >
    <span class="underline underline-offset-4">
        {{ _content }}
    </span>

    <span class="ml-2 no-underline text-muted">
        (Missing HREF)
    </span>
  </span>
{%- endif -%}