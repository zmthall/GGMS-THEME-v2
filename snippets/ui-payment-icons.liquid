{%- comment -%}
  ui-payment-icons

  Shows accepted payment icons using Shopify's enabled payment types.
{%- endcomment -%}

{%- if shop.enabled_payment_types.size > 0 -%}
  <div class="mt-3">
    <ul role="list" class="mt-2 flex flex-wrap items-center justify-center gap-1">
      {%- for type in shop.enabled_payment_types -%}
        <li class="rounded-md border border-border bg-surface p-1 leading-none">
          {{ type | payment_type_svg_tag: class: 'block w-6 h-auto' }}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}