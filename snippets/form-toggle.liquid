{%- comment -%}
  form-toggle (toggle switch)

  Args:
  - name (required)
  - id: defaults from name (sanitized)
  - label: inline label next to switch (optional)
  - heading_label: optional label above
  - checked: boolean (optional)
  - disabled: boolean
  - required: boolean
  - help: tooltip text (optional) — rendered as a tooltip next to the label
  - class: wrapper classes
  - label_class: extra label classes
{%- endcomment -%}

{%- liquid
  assign _name = name
  assign _id = id | default: _name
  assign _id = _id | replace: '[', '_' | replace: ']', '' | replace: ' ', '_' | downcase

  assign _class = class | default: ''
  assign _label_class = label_class | default: ''
  assign _help = help

  assign _disabled = false
  if disabled
    assign _disabled = true
  endif

  assign _required = required | default: false

  assign _checked = false
  if checked == true or checked == 'true' or checked == 1 or checked == '1'
    assign _checked = true
  endif
-%}

<div class="flex flex-col {{ _class }}">
  {%- if heading_label != blank -%}
    {% render 'form-label', for: _id, label: heading_label, required: _required, help: _help %}
  {%- endif -%}

  <label for="{{ _id }}" class="inline-flex items-center gap-2 select-none w-fit {%- if _disabled -%} opacity-60 cursor-not-allowed{%- else -%} cursor-pointer{%- endif -%}">
    <input id="{{ _id }}" name="{{ _name }}" type="checkbox" class="sr-only peer" {%- if _checked -%} checked{%- endif -%} {%- if _disabled -%} disabled{%- endif -%}>

    {%- if label != blank -%}
      <span class="text-text font-semibold {{ _label_class }}">{{ label }}</span>
    {%- endif -%}

    <span class="relative cursor-pointer inline-flex items-center w-16 h-8 rounded-full border-2 bg-surface border-border transition-colors duration-fast ease-standard hover:border-brand-blue hover:bg-brand-blue/5 peer-focus-visible:shadow-interior peer-focus-visible:border-brand-blue peer-focus-visible:outline-2 peer-focus-visible:outline-focus peer-focus-visible:outline-offset-2 peer-checked:bg-brand-blue/20 peer-checked:border-brand-blue peer-checked:**:data-knob:translate-x-8 peer-checked:**:data-knob:border-brand-blue {%- if _disabled -%} pointer-events-none{%- endif -%}" aria-hidden="true">
      <span data-knob class="absolute top-1/2 left-0.5 -translate-y-1/2 size-6 rounded-full bg-surface border-2 border-border transition-transform duration-slow ease-emphasized"></span>
    </span>
  </label>
</div>