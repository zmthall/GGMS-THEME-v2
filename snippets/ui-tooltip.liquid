{%- comment -%}
  ui-tooltip (CSS-only)
  Shows tooltip on:
  - hover (mouse)
  - focus-within (keyboard / click)

  Args:
  - id: unique id base (required)
  - text: tooltip content (required)
  - position: top|bottom (default: top)
  - icon: iconify name (default: "mdi:help-circle-outline")
  - label: accessible label for the trigger (default: "More info")
  - class: wrapper class (optional)
  - trigger_class: trigger button class (optional)
{%- endcomment -%}

{%- liquid
  assign _id = id
  assign _text = text
  assign _pos = position | default: 'top'
  assign _icon = icon | default: 'mdi:help-circle-outline'
  assign _label = label | default: 'More info'
  assign _class = class | default: ''
  assign _trigger_class = trigger_class | default: ''
-%}

{%- capture _pos_classes -%}
  {%- if _pos == 'bottom' -%}
    top-full mt-2
  {%- else -%}
    bottom-full mb-2
  {%- endif -%}
{%- endcapture -%}

<span class="relative inline-flex align-middle group/tooltip {{ _class }}">
  <button
    type="button"
    class="inline-flex items-center justify-center rounded-md
           focus:outline-none focus:ring-2 focus:ring-[#121B75]/30
           {{ _trigger_class }}"
    aria-describedby="{{ _id }}-tooltip"
  >
    <span class="sr-only">{{ _label }}</span>

    {% render 'ui-icon',
      name: _icon,
      size: 'sm',
      class: 'text-[#121B75] opacity-80',
      decorative: true
    %}
  </button>

  <span
    id="{{ _id }}-tooltip"
    role="tooltip"
    class="pointer-events-none absolute z-50 w-max max-w-xs
           rounded-md border border-[#e1e1e1] bg-white px-3 py-2 text-xs font-semibold text-[#1e1e1e]
           shadow-lg opacity-0 scale-95 translate-y-1
           transition duration-150 ease-out
           group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 group-hover/tooltip:translate-y-0
           group-focus-within/tooltip:opacity-100 group-focus-within/tooltip:scale-100 group-focus-within/tooltip:translate-y-0
           left-0 {{ _pos_classes }}"
  >
    {{ _text }}
  </span>
</span>
