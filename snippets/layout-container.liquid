{%- comment -%}
  Params:
    - content: required
    - page_width: boolean (default true)
    - gutters: boolean (default true)
    - class: extra classes
{%- endcomment -%}

{%- liquid
  assign use_page_width = page_width
  if use_page_width == nil
    assign use_page_width = true
  endif

  assign use_gutters = gutters
  if use_gutters == nil
    assign use_gutters = true
  endif

  assign extra = class | default: ''

  assign classes = 'gg-container'
  unless use_page_width
    assign classes = classes | append: ' gg-container--full'
  endunless
  unless use_gutters
    assign classes = classes | append: ' gg-container--no-gutters'
  endunless
  if extra != ''
    assign classes = classes | append: ' ' | append: extra
  endif
-%}


<div class="{{ classes }}">
  {{ content }}
</div>
