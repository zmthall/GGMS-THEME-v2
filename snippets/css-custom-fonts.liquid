{% style %}
  /* ----------------------------
    Gabarito (Body)
  ---------------------------- */
  @font-face {
    font-family: "Gabarito";
    src: url("{{ 'Gabarito-Regular.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Gabarito";
    src: url("{{ 'Gabarito-Medium.woff2' | asset_url }}") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Gabarito";
    src: url("{{ 'Gabarito-SemiBold.woff2' | asset_url }}") format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Gabarito";
    src: url("{{ 'Gabarito-Bold.woff2' | asset_url }}") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  /* ----------------------------
    Noto Serif (Headings)
  ---------------------------- */
  @font-face {
    font-family: "Noto Serif";
    src: url("{{ 'NotoSerif-Regular.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Noto Serif";
    src: url("{{ 'NotoSerif-Italic.woff2' | asset_url }}") format("woff2");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: "Noto Serif";
    src: url("{{ 'NotoSerif-SemiBold.woff2' | asset_url }}") format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Noto Serif";
    src: url("{{ 'NotoSerif-Bold.woff2' | asset_url }}") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Noto Serif";
    src: url("{{ 'NotoSerif-BoldItalic.woff2' | asset_url }}") format("woff2");
    font-weight: 700;
    font-style: italic;
    font-display: swap;
  }
{% endstyle %}
